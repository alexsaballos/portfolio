{
	"extends": "astro/tsconfigs/strict",
	"include": ["src/**/*", "global.d.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			// Source - Specialized Components path section
			"@sections/*": ["./src/components/sections/*"],
			"@ui/*": ["./src/components/ui/*"],
			"@badges/*": ["./src/components/ui/badges/*"],
			"@buttons/*": ["./src/components/ui/buttons/*"],
			"@libraries/*": ["./src/components/ui/libraries/*"],
			"@text/*": ["./src/components/ui/text/*"],
			"@togglers/*": ["./src/components/ui/togglers/*"],
			"@widgets/*": ["./src/components/widgets/*"],

			// Images - Assets component
			"@icons/*": ["./src/assets/icons/*"],
			"@images/*": ["./src/assets/images/*"],

			// Source - Other Items path section
			"@config/*": ["./src/config/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@locales/*": ["./src/locales/*"],
			"@pages/*": ["./src/pages/*"],
			"@scripts/*": ["./src/scripts/*"],
			"@styles/*": ["./src/styles/*"],
			"@typing/*": ["./src/types/*"]
		}
	}
}