---
import { ERRORS } from "@config/errors";
import { METADATA } from "@config/meta";
import { ROUTE } from "@config/routing";
import ErrorLayout from "@layouts/ErrorLayout.astro";
import type { ErrorsCodeType } from "@typing/ErrorsType";

export const getStaticPaths = () => Object.keys(ERRORS).map(
    code => ({ params: { code }}));

// Intercepts requested error layout message
const currentError = ERRORS[Number(Astro.params.code) as ErrorsCodeType];
---

<ErrorLayout code={currentError.code}>
    <div class="flex flex-col text-center gap-5">
        <h1 data-aos="fade-up" data-aos-delay="500" class="text-6xl font-light">Error</h1>
        <h2 data-aos="fade-in" data-aos-delay="1000" class="text-9xl font-bold">{currentError.code}</h2>
        <h3 data-aos="fade-up" data-aos-delay="1500" class="text-6xl font-light">{currentError.name}</h3>
        <h4 data-aos="fade-up" data-aos-delay="2000" class="text-2xl font-light">{currentError.description} <br>
            Not to worry though. Take a look at
            <a class="text-primary hover:text-secondary hover:underline" href=`${ROUTE.home(METADATA.defaultLanguage)}#categories`>other sections</a>
            or return
            <a class="text-primary hover:text-secondary hover:underline" href={ROUTE.home(METADATA.defaultLanguage)}>home</a>.
        </h4>
    </div>
</ErrorLayout>