---
import type { DirectoryPageNamesType } from "../types/PagesType";
import { PAGES } from "../config/pages";
import { METADATA } from "../config/meta";
import PageLayout from "../layouts/PageLayout.astro";
import Navbar from "../components/widgets/Navbar.astro";
import LanguageGate from "../components/sections/LanguageGate.astro";

// Intercepts requested slug and redirects appropriately (fallback to main redirection index)
export const getStaticPaths = () => Object.keys(PAGES).map(
    page => ({ params: { page }}));
const page = Astro.params.page as DirectoryPageNamesType;
---

<PageLayout page={page} lang={METADATA.defaultLanguage}>
    <Navbar />
    <div class="flex-1 flex items-center justify-center">
        <LanguageGate page={PAGES[page].metadata.slug} />
    </div>
</PageLayout>