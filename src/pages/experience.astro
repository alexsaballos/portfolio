---
import { PAGES } from "../config/pages";
import LanguageGate from "../components/sections/LanguageGate/LanguageGate.astro";
import Layout from "../layouts/Layout.astro";
import { SEO } from "../config/routing";

const canonical: string = SEO.canonical("en");
---

<Layout
    title={PAGES.experience.SEO_title}
    description={PAGES.experience.SEO_description}
    canonical_link={canonical}
    navbarBG="transparent">
    <div class="mt-26">
        <LanguageGate page={PAGES.experience.slug} />
    </div>
</Layout>