---
import { LANGUAGES } from "../../config/languages";
import { NAVIGATION_PAGES } from "../../config/pages";

import PageLayout from "@layouts/PageLayout.astro";
import Breadcrumbs from "@ui/Breadcrumbs.astro";

import ComingSoon from "@sections/ComingSoon.astro";
import CertificationsSection from "@sections/CertificationsSection.astro";
import HonorsSection from "@sections/HonorsSection.astro";
import ContactSection from "@sections/contact/ContactSection.astro";
import Navbar from "@widgets/Navbar.astro";

import type { AdmittedLanguagesType } from "@typing/LocalesType";
import type { NavigationPageNamesType } from "@typing/PagesType";

export const getStaticPaths = () =>
    Object.keys(LANGUAGES).flatMap(lang => (
        Object.keys(NAVIGATION_PAGES).map(page => (
            { params: { lang, page }}
        ))
    ));

const { lang, page } = Astro.params as {
    lang: AdmittedLanguagesType;
    page: NavigationPageNamesType;
};
---

<PageLayout page={page} lang={lang}>
    <Navbar />
    <Breadcrumbs page={NAVIGATION_PAGES[page]} />
    <div class="flex-1 flex items-center justify-center">
        {(() => {
            // Section router per section
            switch (page) {
                case "projects": return(<ComingSoon />);
                case "experience": return(<ComingSoon />);
                case "leadership": return(<ComingSoon />);
                case "certifications": return(<CertificationsSection />);
                case "honors": return(<HonorsSection />);
                case "contact": return(<ContactSection />);
                default: return(<ComingSoon />);
            }
        })()}
    </div>
</PageLayout>