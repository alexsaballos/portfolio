---
import { LANGUAGES } from "@config/languages";

import PageLayout from "@layouts/PageLayout.astro";
import Intro from "@sections/Intro.astro";
import About from "@sections/About.astro";
import Stack from "@sections/stack/Stack.astro";
import Categories from "@sections/Categories.astro";

import type { AdmittedLanguagesType } from "@typing/LocalesType";

// Intercepts requested slug and redirects appropriately (fallback to main redirection index)
export const getStaticPaths = () => Object.keys(LANGUAGES).map(
    lang => ({ params: { lang }}));
---

<PageLayout page="home" lang={Astro.params.lang as AdmittedLanguagesType}>
    <Intro />
    <About />
    <Stack />
    <Categories />
</PageLayout>