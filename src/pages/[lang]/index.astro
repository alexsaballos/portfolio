---
import type { AdmittedLanguagesType } from "../../types/LocalesType";

import { LANGUAGES } from "../../config/languages";

import PageLayout from "../../layouts/PageLayout.astro";
import Intro from "../../components/sections/Intro.astro";
import About from "../../components/sections/About.astro";
import Stack from "../../components/sections/stack/Stack.astro";
import Categories from "../../components/sections/Categories.astro";

// Intercepts requested slug and redirects appropriately (fallback to main redirection index)
export const getStaticPaths = () => Object.keys(LANGUAGES).map(
    lang => ({ params: { lang }}));
---

<PageLayout page="home" lang={Astro.params.lang as AdmittedLanguagesType}>
    <Intro />
    <About />
    <Stack />
    <Categories />
</PageLayout>