---
import { PAGES } from "../../config/pages";
import { SEO } from "../../config/routing";

import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import HonorsSection from "../../components/sections/HonorsSection.astro";

const canonical: string = SEO.canonical("en");
---

<Layout
    title={PAGES.honors.SEO_title}
    description={PAGES.honors.SEO_description}
    canonical_link={canonical}
    navbarBG="transparent">
    <!-- mt-26 cancels out -mt-26 on Layout.astro for the fixed Navbar -->
    <div class="mt-26">
        <Breadcrumbs page={PAGES.honors} />
        <HonorsSection />
    </div>
</Layout>