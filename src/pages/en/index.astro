---
import { SEO } from "../../config/meta";
import Layout from "../../layouts/Layout.astro";
import IntroVideo from "../../components/sections/intro/IntroVideo.astro";
import Intro from "../../components/sections/intro/Intro.astro";
import About from "../../components/sections/About.astro";
import Stack from "../../components/sections/Stack.astro";
import Categories from "../../components/sections/Categories.astro";
---

<Layout title={SEO.title()}
        description={SEO.description()}
        canonical_link={SEO.canonical("/")}
        navbarBG="transparent">
    <!-- mt-26 IntroVideo cancels out -mt-26 on Layout.astro. mt-52 returns it to normality -->
    <div class="relative w-full p-10">
        <div class="-mt-26"><IntroVideo /></div>
        <div class="mt-52"><Intro /></div>
    </div>
    <About />
    <Stack />
    <Categories />
</Layout>