---
import { SEO } from "../../config/meta";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Intro from "../../components/sections/intro/Intro.astro";
import About from "../../components/sections/About.astro";
import Stack from "../../components/sections/Stack.astro";
import Categories from "../../components/sections/Categories.astro";

const { locale } = Astro.locals as { locale: string };
---

<BaseLayout title={SEO.title()} description={SEO.description()} locale={locale} canonical_link={SEO.canonical("/")}>
    <Intro />
    <About />
    <Stack />
    <Categories />
</BaseLayout>