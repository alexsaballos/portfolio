---
import { ROUTE } from "@config/routes/routing";
import { METADATA } from "@config/meta";
import { PERSONAL } from "@config/personal";
import { PICTURES } from "@src/config/assets";
import { LANGUAGES } from "@config/languages";
import { LINKS, SYSTEM } from "@config/routes/links"

import Image from "astro/components/Image.astro";

import CommonHead from "@layouts/CommonHead.astro";
import Loader from "@widgets/Loader.astro";
import Avatar from "@ui/Avatar.astro";
import CommonIcon from "@ui/CommonIcon.astro";
import SocialButtons from "@ui/buttons/SocialButtons.astro";
import ThemeToggler from "@ui/togglers/ThemeToggler.astro";

const lang = METADATA.defaultLanguage;
---

<!doctype html>
<html lang={lang} dir={METADATA.text_direction}>
	<CommonHead type="card" lang={lang} />
	<body>
		<Loader />
		<div class="min-h-screen">
            <div class="justify-self-end p-5 scale-150"><ThemeToggler /></div>
			<main id="main-content" class="flex-1 flex flex-col">

                <div class="relative flex flex-col w-full max-w-xl self-center mt-4 mb-2 px-1">
                
                    <!-- Avatar Wrapper -->
                    <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 z-2">
                        <Avatar classname="h-35 w-35 sm:h-40 sm:w-40" />
                    </div>

                    <!-- Main Card Container -->
                    <div class="flex flex-col bg-base-300 rounded-3xl items-start gap-2 p-6 mx-2 shadow-2xl">
                        
                        <div class="flex flex-row justify-between w-full">
                            <!-- QR Code modal opening -->
                            <button aria-label="Open QR Code" onclick="card_qr.showModal()" class="btn btn-ghost btn-square p-0 min-h-0 h-auto bg-transparent shadow-none">
                                <CommonIcon name="qr_code" classname="transition-transform ease-in-out hover:text-primary hover:scale-110" />
                            </button>
                            <!-- Browser native OS sharing behavior -->
                            <button id="card_button_share" aria-label="Share Profile" class="btn btn-ghost btn-square p-0 min-h-0 h-auto bg-transparent shadow-none">
                                <CommonIcon name="share" classname="transition-transform ease-in-out hover:text-secondary hover:scale-110" />
                            </button>
                        </div>

                        <dialog id="card_qr" class="modal modal-middle">

                            <!-- Status toasts triggered via client-side JS -->
                            <div class="toast toast-center toast-top mt-3 md:mt-17 z-999">
                                <div id="card_toast_success" role="alert" class="hidden alert alert-success rounded-4xl transition-transform duration-500 ease-out hover:scale-120">
                                    <CommonIcon name="circle_check" />
                                    Link copied successfully!
                                </div>
                            </div>
                            
                            <div class="modal-box text-center py-6 flex flex-col self-center justify-center items-center gap-5 border border-base-200/50">
                                
                                <!-- Top Row: Close Button -->
                                <form method="dialog" class="absolute right-4 top-4">
                                    <button class="btn btn-sm btn-circle btn-ghost text-base-content/60">
                                        <CommonIcon name="circle_xmark" />
                                    </button>
                                </form>

                                <!-- Header Content -->
                                <div class="space-y-1">
                                    <h3 class="text-2xl font-bold tracking-tight text-base-content">Scan to Connect</h3>
                                    <p class="text-xs text-base-content/60 font-medium">Share my profile instantly</p>
                                </div>

                                <!-- QR Code Container (Strict high-contrast wrapper) -->
                                <div class="bg-white p-2 rounded-2xl shadow-xl shadow-base-300/10 border border-base-300 flex items-center justify-center">
                                    <Image src="/card/qr.svg" width={220} height={220} class="aspect-square object-contain" alt="Scan this QR code to visit my professional landing page" />
                                </div>

                                <!-- Action Bar: Copy URL & Download -->
                                <div class="join w-full max-w-xs justify-center">
                                    <input name="card_link_modal" readonly aria-readonly="true" type="text" value={SYSTEM.notable.card_utm}
                                        class="input input-primary input-sm shadow-none select-none rounded-l-lg font-mono text-xs" />
                                    <button id="card_button_copy" onclick={`navigator.clipboard.writeText("${SYSTEM.notable.card_utm}")`}
                                        class="btn btn-sm btn-primary shadow-none rounded-none text-xs font-semibold text-primary-content">
                                        <CommonIcon name="copy" />
                                    </button>
                                    <a download href="/card/qr.svg"
                                        class="btn btn-sm btn-secondary shadow-none rounded-r-lg text-xs font-semibold text-primary-content">
                                        <CommonIcon name="download" />
                                    </a>
                                </div>

                            </div>
                            
                            <!-- Click outside backdrop to close -->
                            <form method="dialog" class="modal-backdrop bg-black/40 backdrop-blur-xs">
                                <button></button>
                            </form>
                        </dialog>

                        <dialog id="card_preview" class="modal modal-middle">
                            
                            <div class="modal-box text-center py-6 flex flex-col self-center justify-center items-center gap-5 border border-base-200/50">
                                
                                <!-- Top Row: Close Button -->
                                <form method="dialog" class="absolute right-4 top-4">
                                    <button class="btn btn-sm btn-circle btn-ghost text-base-content/60">
                                        <CommonIcon name="circle_xmark" />
                                    </button>
                                </form>

                                <div class="flex flex-col gap-5">
                                    <!-- Header Content -->
                                    <div class="space-y-1">
                                        <h3 class="text-2xl font-bold tracking-tight text-base-content">Preview my Card</h3>
                                        <p class="text-xs text-base-content/60 font-medium">Request one through my contact form</p>
                                    </div>

                                    <!-- 3D Business Cards Preview (8 div tags are needed for 3D effect rendering) -->
                                    <div class="flex flex-col items-center gap-5">
                                        {[PICTURES.cards.v1, PICTURES.cards.v2].map((card, i) => (
                                            <div class="hover-3d">
                                                <figure class={`rounded-2xl ${(i === 0) ? "w-60 md:w-65" : "w-40 md:w-45"}`}>
                                                    <Image src={card} alt={`Professional Business Card v${i+1}`} />
                                                </figure>
                                                {[...Array(8)].map(() => (<div></div>))}
                                            </div>
                                        ))}
                                    </div>
                                </div>

                            </div>
                            
                            <!-- Click outside backdrop to close -->
                            <form method="dialog" class="modal-backdrop bg-black/40 backdrop-blur-xs">
                                <button></button>
                            </form>
                        </dialog>

                        <!-- Header Section with Availability Badge -->
                        <div class="flex flex-col text-center items-center w-full gap-2 mt-4">
                            <h1 class="text-4xl font-bold tracking-tight">{PERSONAL.name}</h1>
                            <h2 class="text-md font-medium text-primary">Electrical & Software Engineer</h2>
                            <div class="flex flex-wrap justify-center gap-2 sm:gap-4">
                                <span class="flex flex-row gap-2 opacity-60">
                                    <CommonIcon name="earth" />
                                    <p class="text-sm">The Americas</p>
                                </span>
                                <span class="flex flex-row gap-2 ">
                                    <CommonIcon name="industry" classname="opacity-60" />
                                    <a class="link link-primary text-sm focus-visible:rounded-sm" href={LINKS.organizations.sidimaqsa}>
                                        SIDIMAQSA
                                    </a>
                                </span>
                                <span class="flex flex-row gap-2 ">
                                    <CommonIcon name="graduation" classname="opacity-60" />
                                    <a class="link link-secondary text-sm focus-visible:rounded-sm" href={LINKS.organizations.hu.main}>
                                        Harding University
                                    </a>
                                </span>
                            </div>
                            <span class="inline-flex items-center gap-2 mt-2 px-3 py-1 rounded-full text-xs font-medium bg-success/10 text-success border border-success/20">
                                <span class="w-2 h-2 rounded-full bg-success animate-pulse select-none outline-none"></span>
                                Available for projects
                            </span>
                        </div>

                        <!-- Bio / About -->
                        <div class="flex flex-col my-2 gap-6 border-y border-base-100 py-6">
                            <div class="space-y-2">
                                <h3 class="text-xs uppercase tracking-wider opacity-50 font-bold">About</h3>
                                <p class="text-sm leading-relaxed opacity-90">
                                    Spanning the stack from power distribution and PCB design to embedded firmware and robust software infrastructure.
                                </p>
                            </div>

                            <!-- Credentials -->
                            <div class="space-y-2">
                                <h3 class="text-xs uppercase tracking-wider opacity-50 font-bold">Credentials</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {["EI/EiT US License", "US BSc. Electrical Engineering", "HU Walton Alumnus"].map(entry => (
                                        <span class="px-3 py-1 text-xs bg-primary/5 text-primary rounded-lg border border-primary/20 font-medium tracking-wide">{entry}</span>
                                    ))}
                                </div>
                            </div>

                            <!-- Specialties -->
                            <div class="space-y-2">
                                <h3 class="text-xs uppercase tracking-wider opacity-50 font-bold">Specialties</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {["Embedded Systems", "PCB Design", "Industrial Automation", "Software Engineering", "Web/Mobile/Desktop App Developer"].map(entry => (
                                        <span class="px-3 py-1 text-xs bg-base-100 opacity-50 rounded-lg border border-gray-400 font-mono tracking-wide">{entry}</span>
                                    ))}
                                </div>
                            </div>

                            <!-- Languages -->
                            <div class="space-y-2">
                                <h3 class="text-xs uppercase tracking-wider opacity-50 font-bold">Languages</h3>
                                <div class="flex flex-wrap gap-1.5">
                                    {Object.values(LANGUAGES).map(entry => (
                                        <span class="px-3 py-1 text-xs bg-secondary/5 text-secondary rounded-lg border border-secondary/20 font-medium tracking-wide">{entry.name.standard}</span>
                                    ))}
                                </div>
                            </div>
                            
                            <!-- Business card preview -->
                            <div class="space-y-2">
                                <h3 class="text-xs uppercase tracking-wider opacity-50 font-bold">Business Card</h3>
                                <p class="text-sm leading-relaxed">
                                    <span class="opacity-90">Preview my physical business cards</span>
                                    <span>
                                        <button aria-label="Open Business Card Preview" onclick="card_preview.showModal()" class="link link-primary text-sm focus-visible:rounded-sm">
                                            here
                                        </button>.
                                    </span>
                                </p>
                            </div>
                        </div>

                        <!-- Social Media Row -->
                        <div class="self-center w-full">
                            <div class="scale-90 text-gray-600"><SocialButtons variant="social" /></div>
                        </div>

                        <!-- Primary Actions Area -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full border-t border-base-100 pt-6">
                            <a href={ROUTE.home(lang)} aria-label="Website"
                                class="btn btn-primary hover-animate rounded-2xl gap-2 font-medium">
                                <CommonIcon name="globe" />
                                <span>Website</span>
                            </a>
                            <a download href={METADATA.vcard_vcf} aria-label="Save vCard"
                                class="btn btn-secondary hover-animate rounded-2xl gap-2 font-medium">
                                <CommonIcon name="download" />
                                <span>Save vCard</span>
                            </a>
                            <a href={ROUTE.page(lang, "contact")} aria-label="Message"
                                class="btn btn-success btn-outline hover-animate rounded-2xl gap-2 font-medium">
                                <CommonIcon name="paper_plane" />
                                <span>Message</span>
                            </a>
                            <button id="gw_button" aria-label="Add to Google Wallet"
                                class="btn btn-error btn-outline hover-animate rounded-2xl gap-2 font-medium sm:col-span-full">
                                <CommonIcon name="google_wallet" size="sm" />
                                <span>Add to Google Wallet</span>
                            </button>
                        </div>

                    </div>
                </div>

                <!-- Client-side JS that controls contact-info email sending responses thorugh toast alerts -->
                <script src="@scripts/pages/card.ts"></script>

			</main>
		</div>
	</body>
</html>