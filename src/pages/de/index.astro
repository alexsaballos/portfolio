---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SEO } from "../../config/meta";
import { ASSETS } from "../../config/assets";
import Icon from "../../components/ui/Icon.astro";

const lang = "de"
---

<BaseLayout title={SEO.title()} description={SEO.description()} locale={lang} canonical_link={SEO.canonical("/")}>
    <h1>Hallo!</h1>
    <span class="text-rotate text-2xl">
        <span class="justify-items-center">
            <span>¡Hola!</span>
            <span>Hello!</span>
            <span>Hallo!</span>
        </span>
    </span>
    <h1 class="text-5xl font-bold">Alexander Saballos</h1>
    <video
        class="absolute inset-0 h-100 object-cover opacity-20 w-full"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
    >
        <source src="/testing/assets/misc/intro.mp4" type="video/mp4" />
        <!-- Optional fallback -->
    </video>
    <Icon icon={ASSETS.icons.merit} size="xl" />
    <Icon icon={ASSETS.icons.handshake} size="xl" />
</BaseLayout>