---
import { SEO } from "../../config/routing";
import { PAGES } from "../../config/pages";

import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import ContactSection from "../../components/sections/contact/ContactSection.astro";

const canonical: string = SEO.canonical("de");
---

<Layout
    title={PAGES.contact.SEO_title}
    description={PAGES.contact.SEO_description}
    canonical_link={canonical}
    navbarBG="transparent">
    <!-- mt-26 cancels out -mt-26 on Layout.astro for the fixed Navbar -->
    <div class="mt-26">
        <Breadcrumbs page={PAGES.contact} />
        <ContactSection />
    </div>
</Layout>