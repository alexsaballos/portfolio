---
import Scroller from '@widgets/Scroller.astro';
import Footer from '@sections/Footer.astro';
import Loader from "@widgets/Loader.astro";
import CommonHead from "@layouts/CommonHead.astro";

import { METADATA } from '@config/meta';
import { getLocaleMessages } from '@locales/utils';

import type { AdmittedLanguagesType } from '@typing/LocalesType';
import type { DirectoryPageNamesType } from '@typing/PagesType';

// Layout parametrization for every page
const { page, lang } = Astro.props as {
	page: DirectoryPageNamesType;
    lang: AdmittedLanguagesType;
};

// Astro system-wide language save
Astro.locals.l = lang;
Astro.locals.t = await getLocaleMessages(lang);
---

<!doctype html>
<html lang={lang} dir={METADATA.text_direction}>
	<CommonHead type="standard" lang={lang} page={page} />
	<body>
		<Loader />
		<div class="min-h-screen flex flex-col">
			<main id="main-content" class="flex-1 flex flex-col">
				<slot />	<!-- Dynamic page insertion -->
			</main>
			<Footer />		<!-- Footer included with every page -->
		</div>
		<Scroller />		<!-- Fixed scroller floating buttons only on standard pages -->
	</body>
</html>