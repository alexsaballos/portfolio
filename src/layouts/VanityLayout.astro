---
import "aos/dist/aos.css";
import '@styles/global.css';

import { VANITY } from '@config/vanity';
import { METADATA } from '@config/meta';
import { FAVICONS } from '@config/assets';
import { PERSONAL } from '@config/personal';
import { LINKS, SYSTEM } from '@config/links';
import { SCHEMAORG_GRAPH } from '@config/entities/graph';
import { getLocaleMessages } from '@locales/utils';

import type { VanityNamesType } from '@typing/VanityType';

import Footer from '@sections/Footer.astro';
import Navbar from '@widgets/Navbar.astro';
import Loader from "@widgets/Loader.astro";

// Layout parametrization for every page
const profile = Astro.props.profile as VanityNamesType;

// Current profile SEO determination
const lang = METADATA.defaultLanguage;
const currentSEO = VANITY[profile].SEO;

// Astro system-wide language save
Astro.locals.l = lang;
Astro.locals.t = await getLocaleMessages(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<!-- General metadata including icon -->
		<meta charset={METADATA.charset} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="application-name" content={METADATA.siteName} />
		<meta name="description" content={currentSEO.description} />
		<meta name="author" content={PERSONAL.name} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href={METADATA.favicon} type="image/x-icon" />
		<link rel="manifest" href={METADATA.manifest} />
		<title>{currentSEO.title}</title>

		<!-- Robots & Crawlers -->
		<meta name="robots" content="index,follow" />
		<meta name="googlebot" content="index,follow" />

		<!-- Theme Management -->
		<meta name="theme-color" content={METADATA.colors.light.background} />
		<meta name="theme-color-light" content={METADATA.colors.light.background} />
		<meta name="theme-color-dark" content={METADATA.colors.dark.background} />
        <meta name="color-scheme" content="light dark" />
		<style>html {visibility: hidden;}</style>

		<!-- SEO - Monolingual Vanity Canonical Links -->
		<link rel="canonical" href={currentSEO.canonical} />

		<!-- rel="me" Verification System -->
		{Object.values(LINKS.profiles).map(entry => <link rel="me" href={entry} /> )}

		<!-- Microsoft -->
		<meta name="msapplication-TileColor" content={METADATA.colors.dark.primary} />

		<!-- Apple -->
		<link rel="apple-touch-icon" href={FAVICONS.apple180.src} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content={METADATA.siteName} />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="format-detection" content="telephone=no,email=no,address=no" />

		<!-- OpenGraph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={currentSEO.canonical} />
		<meta property="og:title" content={currentSEO.title} />
		<meta property="og:site_name" content={METADATA.siteName} />
		<meta property="og:description" content={currentSEO.description} />
		<meta property="og:locale" content={lang} />
		<meta property="og:image" content={METADATA.opengraph.image} />
		<meta property="og:image:url" content={METADATA.opengraph.image} />
		<meta property="og:image:secure_url" content={METADATA.opengraph.image} />
		<meta property="og:image:type" content={METADATA.opengraph.image_type} />
		<meta property="og:image:alt" content={METADATA.siteName} />
		<meta property="og:image:width" content={METADATA.opengraph.image_width} />
		<meta property="og:image:height" content={METADATA.opengraph.image_height} />

		<!-- Twitter -->
		<meta property="twitter:url" content={currentSEO.canonical} />
		<meta property="twitter:domain" content={SYSTEM.domain} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={currentSEO.title} />
		<meta name="twitter:description" content={currentSEO.description} />
		<meta name="twitter:image" content={METADATA.opengraph.image} />
		<meta name="twitter:image:alt" content={METADATA.siteName} />

		<!-- Schema.org Entities & Graph (Three-Entity Schema.org Graph) | No speculation API -->
		<script is:inline type="application/ld+json" set:html={SCHEMAORG_GRAPH(lang, "home")} />
		
		<!-- Google tag (gtag.js) -->
		<script is:inline async src={METADATA.api_keys.google_analytics.stream_url} />
		<script>
            import { initGoogleAnalytics } from "@scripts/google-analytics.ts";
            initGoogleAnalytics("vanity");
        </script>
	</head>
	<body>
		<Loader />
		<div class="min-h-screen flex flex-col">
			<Navbar />
			<main id="main-content" class="flex-1 flex items-center justify-center py-30 md:py-0 md:pb-2 px-5">
				<slot />						<!-- Dynamic page insertion -->
			</main>
			<Footer />							<!-- Footer included with every page -->
		</div>

		<!-- Scripts at the very bottom of the page -->
        <noscript><style>
			html {visibility: visible !important;}
		</style></noscript>
		<script src="@scripts/global.ts"></script>
	</body>
</html>