---
import '../styles/global.css';

import { SITE } from '../config/meta';
// import { FAVICONS } from '../config/assets';
import { PERSONAL } from '../config/personal';
import { getLocaleMessages } from '../i18n/utils';

import IconLibrary from '../components/ui/IconLibrary.astro';
import Footer from '../components/sections/footer/Footer.astro';
import Navbar from '../components/widgets/Navbar.astro';
import Scroller from '../components/widgets/Scroller.astro';

const { title, description, canonical_link } = Astro.props;
const locale = Astro.currentLocale ?? "en";

Astro.locals.locale = locale;
Astro.locals.t = await getLocaleMessages(locale);
---

<html lang={locale}>
	<head>
		<meta charset={SITE.charset} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />

		<title>{title}</title>

		<!-- Load saved theme from localStorage and fallback to light theme -->
		<style>html {visibility: hidden;}</style>
		<script is:inline type="module" src={`${PERSONAL.base}scripts/theme-load.js`}></script>

		<link rel="icon" href={SITE.favicon} type="image/x-icon" />
		<link rel="manifest" href={SITE.manifest} />
		<link rel="canonical" href={canonical_link} />

		<!-- iPhone full compatibility -->
		<!-- <link rel="apple-touch-icon" href={FAVICONS.apple180} /> -->
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />

		<!-- OpenGraph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical_link} />
		<meta property="og:image" content={SITE.ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={SITE.ogImage} />
	</head>
	<body>
		<IconLibrary />						<!-- Inject all Icons early on in the DOM -->
		<div><slot/></div>					<!-- Dynamic page insertion for sticky NavBar -->
		<Scroller />						<!-- Fixed scroller floating buttons on all screen sizes -->
		<Footer />							<!-- Footer included with every page -->
		<script is:inline type="module" src={`${PERSONAL.base}scripts/global.js`}></script>
	</body>
</html>