---
/* Current head tag implementations:
    - Google Analytics 4 & Google Tag
    - Google Search Console (DNS Verification)
    - Bing Webmaster Tools (GCS Verification)
    - GitHub & Resend DNS Verification
    - GA4 & GCS Integration
    - Referrer Policy
    - Workbox Service Worker
    - Full PWA Implementation
    - humans.txt
    - manifest.webmanifest
    - robots.txt
    - sitemap.xml
    - Schema.org Graph (3 entities + BreadcrumbList + Profile Page + OccupationalExp)
    - Favicon Ecosystem
    - Apple Metadata
    - Microsoft Metadata
    - Opengraph Metadata (OG)
    - Twitter Metadata
    - Speculation API Rules
    - Canonical URLs
    - hreflang
    - rel="me" Verification System

   Possible future head tag implementations:
    - RSS Feed

    Non-head tag implementations:
    - ./well-known/security.txt
    - ./well-known/webfinger
    - NFC & QR Enabled Business Cards
*/

import "aos/dist/aos.css";
import "@src/global.css";

import { SEO } from "@config/routes/routing";
import { PAGES } from "@config/routes/pages";
import { VANITY } from "@config/routes/vanity";
import { ERRORS } from "@config/routes/errors";
import { METADATA } from "@config/meta";
import { FAVICONS } from "@config/assets";
import { PERSONAL } from "@config/personal";
import { LANGUAGES } from "@config/languages";
import { LINKS, SYSTEM } from "@config/routes/links";
import { SCHEMAORG_GRAPH } from "@config/schemaorg/graph";
import { SPECULATION } from "@scripts/global/speculation";

import type { ErrorsCodeType } from "@typing/ErrorsType";
import type { VanityNamesType } from "@typing/VanityType";
import type { DirectoryPageNamesType } from "@typing/PagesType";
import type { AdmittedLanguagesType } from "@typing/LocalesType";

const { type, lang, page, profile, code } = Astro.props as {
    type: "standard" | "card" | "vanity" | "error";
    lang: AdmittedLanguagesType;
    page?: DirectoryPageNamesType;
    profile?: VanityNamesType;
    code?: ErrorsCodeType;
}

const getCurrentSEO = () => {
    switch (type) {
        case "standard": return {
            title: PAGES[page!].SEO.title,
            description: PAGES[page!].SEO.description,
            slug: PAGES[page!].metadata.slug,
            canonical: SEO.canonical.page(lang!, PAGES[page!].metadata.slug)
        };
        case "card": return {
            title: PAGES["card"].SEO.title,
            description: PAGES["card"].SEO.description,
            slug: PAGES["card"].metadata.slug,
            canonical: SEO.canonical.page(lang!, PAGES["card"].metadata.slug)
        };
        case "vanity": return VANITY[profile!].SEO;
        case "error": return (ERRORS[code!] ?? ERRORS[500]);
    }
};

const isNotError = (type !== "error");
const isStandard = (type === "standard");

const currentSEO = getCurrentSEO();
const currentLang = lang ?? METADATA.defaultLanguage;
---

<head data-analytics-type={type}>
    <!-- General metadata including icon -->
    <meta charset={METADATA.charset} />
    <meta name="application-name" content={METADATA.siteName} />
    <meta name="description" content={currentSEO.description} />
    <meta name="author" content={PERSONAL.name} />
    <meta name="creator" content={PERSONAL.name} />
    <meta name="publisher" content={PERSONAL.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{currentSEO.title}</title>

    <!-- Referrer & CSP Policies -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />

    <!-- Webmention enabling - webmention.io -->
    <link rel="webmention" href={SYSTEM.API.webmention} />

    <!-- Icons & Manifest -->
    <link rel="manifest" href={METADATA.manifest} />
    <link rel="icon" type={FAVICONS.browser.svg.type} href={FAVICONS.browser.svg.src} />
    <link rel="icon" type={FAVICONS.browser.ico.type} href={FAVICONS.browser.ico.src} />
    <link rel="mask-icon" href={FAVICONS.browser.safari_mask.src} color={METADATA.colors.dark.primary} />
    <link rel="apple-touch-icon" href={FAVICONS.manifest.apple180.src} sizes={FAVICONS.manifest.apple180.sizes} />

    <!-- Robots, Crawlers, & Sitemap.xml - Errors must never be indexed -->
    <meta name="robots" content={isNotError ? "index,follow" : "noindex,nofollow"} />
    <meta name="bingbot" content={isNotError ? "index,follow" : "noindex,nofollow"} />
    <meta name="googlebot" content={isNotError ? "index,follow" : "noindex,nofollow"} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={METADATA.sitemap} />

    <!-- Humans.txt File -->
    <link rel="author" type="text/plain" title="Humans" href={METADATA.humans} />

    <!-- Theme Management -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={METADATA.colors.dark.background} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={METADATA.colors.light.background} media="(prefers-color-scheme: light)" />

    <!-- SEO - Canonical Links -->
    <!-- Only errors are not allowed to have a canonical link -->
    <!-- Only standard pages are allowed to be multilingual with canonical links -->
    {isNotError && (
        <>
            <link rel="canonical" href={currentSEO.canonical} />
            {isStandard && (
                <>
                    {Object.values(LANGUAGES).map(entry => (
                        <link rel="alternate" hreflang={entry.code.lang} href={SEO.canonical.page(entry.code.lang, currentSEO.slug)} />
                    ))}
                    <link rel="alternate" hreflang="x-default" href={SEO.canonical.page(METADATA.defaultLanguage, currentSEO.slug)} />
                </>
            )}
        </>
    )}

    <!-- rel="me" Verification System - Only errors are disallowed to have them -->
    {isNotError && Object.values(LINKS.profiles).map(entry => <link rel="me" href={entry} /> )}

    <!-- Platform-specific Metadata generator -->
    <!-- Microsoft -->
    <meta name="msapplication-TileColor" content={METADATA.colors.dark.primary} />

    <!-- Apple -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={METADATA.siteName} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={currentSEO.title} />
    <meta property="og:site_name" content={METADATA.siteName} />
    <meta property="og:description" content={currentSEO.description} />
    <meta property="og:locale" content={LANGUAGES[currentLang].code.langcountry} />
    {isStandard && Object.values(LANGUAGES).map(entry =>
        (entry.key !== currentLang) && (
        <meta property="og:locale:alternate" content={entry.code.langcountry}/>
    ))}
    {isNotError && (
        <>
            <meta property="og:url" content={currentSEO.canonical} />
            <meta property="og:image" content={METADATA.opengraph.image} />
            <meta property="og:image:url" content={METADATA.opengraph.image} />
            <meta property="og:image:secure_url" content={METADATA.opengraph.image} />
            <meta property="og:image:type" content={METADATA.opengraph.image_type} />
            <meta property="og:image:alt" content={METADATA.siteName} />
            <meta property="og:image:width" content={METADATA.opengraph.image_width} />
            <meta property="og:image:height" content={METADATA.opengraph.image_height} />
        </>
    )}

    <!-- Twitter -->
    <meta name="twitter:domain" content={SYSTEM.domain} />
    <meta name="twitter:card" content={isNotError ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={currentSEO.title} />
    <meta name="twitter:description" content={currentSEO.description} />
    {isNotError && (
        <>
            <meta name="twitter:url" content={currentSEO.canonical} />
            <meta name="twitter:image" content={METADATA.opengraph.image} />
            <meta name="twitter:image:alt" content={METADATA.siteName} />
            <meta name="twitter:image:src" content={METADATA.opengraph.image} />
        </>
    )}

    <!-- Schema.org Entities & Graph (Four-Entity Schema.org Graph) | Speculation API -->
    <!-- Schema.org graph only disallowed on error pages -->
    <!-- Speculation only allowed on standard pages -->
    {isNotError && <script is:inline type="application/ld+json" set:html={SCHEMAORG_GRAPH(currentLang, (isStandard ? page! : "home"))}></script>}
    {isStandard && <script is:inline type="speculationrules" set:html={JSON.stringify(SPECULATION())}></script>}

    <!-- Google tag (gtag.js) & Global script initializer -->
    <script is:inline async src={METADATA.api_keys.google_analytics.stream_url}></script>
    <script src="@scripts/global.ts"></script>
</head>