---
import '../styles/global.css';

import { METADATA } from '../config/meta';
import { PATHS } from '../config/assets';
import { FAVICONS } from '../config/assets';
import { getLocaleMessages } from '../i18n/utils';
import type { AdmittedLanguagesType } from '../types/LocalesType';

import IconLibrary from '../components/ui/libraries/IconLibrary.astro';
import FlagLibrary from '../components/ui/libraries/FlagLibrary.astro';
import Navbar from '../components/widgets/Navbar.astro';
import Scroller from '../components/widgets/Scroller.astro';
import Footer from '../components/sections/Footer.astro';

const { title, description, canonical_link, navbarBG } = Astro.props as {
	title: string;
	description: string;
	canonical_link: string;
	navbarBG: string;
};

const locale: AdmittedLanguagesType = (Astro.currentLocale ?? "en") as AdmittedLanguagesType;

Astro.locals.locale = locale;
Astro.locals.t = await getLocaleMessages(locale);
---

<html lang={locale}>
	<head>
		<meta charset={METADATA.charset} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />

		<title>{title}</title>

		<!-- Load saved theme from localStorage and fallback to light theme -->
		<style>html {visibility: hidden;}</style>
		<script is:inline type="module" src={`${PATHS.scripts}theme-load.js`}></script>

		<link rel="icon" href={METADATA.favicon} type="image/x-icon" />
		<link rel="manifest" href={METADATA.manifest} />
		<link rel="canonical" href={canonical_link} />

		<!-- iPhone full compatibility -->
		<link rel="apple-touch-icon" href={FAVICONS.apple180.src} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />

		<!-- OpenGraph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical_link} />
		<meta property="og:image" content={METADATA.ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={METADATA.ogImage} />
	</head>
	<body>
		<IconLibrary /><FlagLibrary />		<!-- Inject all Icons early on in the DOM -->
		<Navbar background={navbarBG} />	<!-- Fixed Navigation Bar -->
		<div class="-mt-26"><slot/></div>	<!-- Dynamic page insertion (Accounts for Navbar top offset) -->
		<Scroller />						<!-- Fixed scroller floating buttons on all screen sizes -->
		<Footer />							<!-- Footer included with every page -->
		<script is:inline type="module" src={`${PATHS.scripts}global.js`}></script>
	</body>
</html>