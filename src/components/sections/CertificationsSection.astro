---
import { CERT_KEYS, CERT_LINKS } from "@config/certifications";

import Title from "@text/Title.astro";
import Image from "astro/components/Image.astro";
import TestIcon from "@ui/TestIcon.astro";
import Resources from "@ui/badges/Resources.astro";

const t = Astro.locals.t.certifications;
---

<section data-aos="fade-up" class="pb-10 px-5 lg:px-10 xl:px-20">
	<Title title={t.texts.title} classname="mt-4 mb-8" />

	<div class="gap-6 flex flex-col lg:grid lg:grid-cols-3 lg:grid-rows-2">
		{CERT_KEYS.map(organization => (
			<div data-aos="zoom-in" class="bg-base-200 rounded-4xl p-6 ring-4 ring-gray-500 relative">

				<Image src={CERT_LINKS[organization].picture} alt={`${t[organization].name} Logo`}
					class="w-full rounded-2xl place-self-center max-h-40 max-w-120" />

				<h3 class="text-xl text-secondary font-bold my-4">
					{`${t[organization].name} [${(organization == "iassc") ? (t.texts.planned + " ") : ""}${CERT_LINKS[organization].year}]`}
				</h3>
				<ul class="space-y-4">
					<li>					
						<details class="group">
							<summary class="list-none cursor-pointer">
								<p class="text-sm text-base-content/70 group-open:hidden">{t[organization].summary}</p>
								<span class="flex flex-row gap-2 text-sm text-secondary my-1 group-open:hidden hover:underline">
									{t.texts.description}
									<TestIcon name="chevron_down" size="xs" classname="mt-0.5" />
								</span>
							</summary>
							<p class="text-sm text-base-content/70 mt-2">{t[organization].details}</p>
						</details>
						
						<div class="flex flex-row flex-wrap items-center gap-2 my-2">
							<p class="text-xs tracking-wide leading-none uppercase text-base-content/60">{t.texts.resources}</p>
							<div class="flex flex-wrap gap-2">
								<Resources variant="certification"
										link={CERT_LINKS[organization].verification} text={t[organization].verification} />
								<Resources variant="external"
										link={CERT_LINKS[organization].info} text={t[organization].info} />
							</div>
						</div>
					</li>
				</ul>
			</div>
		))}
	</div>
</section>