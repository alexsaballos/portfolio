---
import { CERT_KEYS, CERT_LINKS } from "../../config/certifications";
import { ICONS } from "../../config/assets";
import type { LocalesType } from "../../types/LocalesType";

import Icon from "../ui/libraries/Icon.astro";
import Title from "../ui/text/Title.astro";
import Image from "astro/components/Image.astro";

const { t } = Astro.locals as { t: LocalesType; }
---

<section class="pb-10 px-5 lg:px-10 xl:px-20">
	<Title title={t.certifications.texts.title} classname="mt-4 mb-8" />

	<div class="gap-6 flex flex-col lg:grid lg:grid-cols-3 lg:grid-rows-2">
		{CERT_KEYS.map(organization => (
			<div class="bg-base-200 rounded-4xl p-6 ring-4 ring-gray-500 relative">

				<Image src={CERT_LINKS[organization].picture} alt={`${t.certifications[organization].name} Logo`}
					class="w-full rounded-2xl place-self-center max-h-40 max-w-120" />

				<h3 class="text-xl text-secondary font-bold my-4">
					{`${t.certifications[organization].name} [${(organization == "iassc") ? (t.certifications.texts.planned + " ") : ""}${CERT_LINKS[organization].year}]`}
				</h3>
				<ul class="space-y-4">
					<li>					
						<details class="group">
							<summary class="list-none cursor-pointer">
								<p class="text-sm text-base-content/70 group-open:hidden">{t.certifications[organization].summary}</p>
								<span class="flex flex-row gap-2 text-sm text-secondary my-1 group-open:hidden hover:underline">
									{t.honors.texts.description}
									<Icon icon={ICONS.angles_down} size="xs" classname="mt-0.5" />
								</span>
							</summary>
							<p class="text-sm text-base-content/70 mt-2">{t.certifications[organization].details}</p>
						</details>
						
						<div class="flex flex-row flex-wrap items-center gap-2 my-2">
							<p class="text-xs tracking-wide leading-none uppercase text-base-content/60">{t.honors.texts.resources}</p>
							<div class="flex flex-wrap gap-2">
								{CERT_LINKS[organization].verification && 
									<a href={CERT_LINKS[organization].verification} target="_blank" rel="noopener noreferrer"
										class="badge badge-accent badge-sm rounded-4xl transition-transform duration-500 ease-out hover:scale-105 hover:opacity-70" >
										<Icon icon={ICONS.certifications} size="xs" />
										{t.certifications[organization].verification}
									</a>
								}
								<a href={CERT_LINKS[organization].info} target="_blank" rel="noopener noreferrer"
									class="badge badge-primary badge-sm rounded-4xl transition-transform duration-500 ease-out hover:scale-105 hover:opacity-70">
									<Icon icon={ICONS.link} size="xs" />
									{t.certifications[organization].info}
								</a>
							</div>
						</div>
					</li>
				</ul>
			</div>
		))}
	</div>
</section>