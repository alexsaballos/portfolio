---
import { ASSETS } from "../../../config/assets";
import type { Translations } from "../../../types/locales";

import Avatar from "../../ui/Avatar.astro";
import SocialButtons from "../../ui/SocialButtons.astro";
import Navbar from "../../widgets/Navbar.astro";
import IntroVideo from "./IntroVideo.astro";

const { t } = Astro.locals as {
    t: Translations
};
const HELLO_ROTATING = {
    de: {
        word: "Hallo!",
        flag: ASSETS.flags.de
    },
    en: {
        word: "Hello!",
        flag: ASSETS.flags.en
    },
    es: {
        word: "¡Hola!",
        flag: ASSETS.flags.es
    },
}
---

<div class="relative w-full py-5 pb-10">
    <IntroVideo />
    <Navbar />
    <div class="relative z-10 p-5 gap-10 text-center justify-center flex flex-col lg:flex-row items-center">
        <Avatar classname="justify-center w-60 h-60" />
        <div>
            <span class="align-middle">
                <span class="text-rotate duration-5000 text-4xl font-mono">
                    <span class="justify-items-center">
                        {Object.values(HELLO_ROTATING).map(word => (
                            <span class="inline-flex items-center align-middle gap-2">
                                <img src={word.flag} loading="eager" class="h-6 w-6" />
                                {word.word}
                            </span>
                        ))}
                    </span>
                </span>
                <span class="text-2xl">{t.intro.name_is}</span>
            </span>
            <h1 class="text-6xl sm:text-7xl font-bold mt-2">{t.intro.name}</h1>
            <h2 class="text-xl my-2">{t.intro.headline}</h2>
            <SocialButtons />
        </div>
    </div>
</div>