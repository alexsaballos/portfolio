---
import { ICONS } from "../../../config/assets";
import type { LocalesType } from "../../../types/LocalesType";

import RotatingText from "../../ui/RotatingText.astro";
import Avatar from "../../ui/Avatar.astro";
import SocialButtons from "../../ui/buttons/SocialButtons.astro";
import Icon from "../../ui/libraries/Icon.astro";

const { t } = Astro.locals as { t: LocalesType; };
---

<section class="flex flex-col gap-10">
    <div class="gap-10 text-center justify-center flex flex-col items-center">
        <Avatar classname="justify-center w-60 h-60" />

        <!-- Includes: Rotating Hello, introduction, headline, and SocialButtons -->
        <div class="group">
            <span class="align-middle">                
                <RotatingText text="hello" classname="text-4xl" />
                <span class="text-2xl">{t.intro.name_is}</span>
            </span>
            <h1 class="text-6xl sm:text-7xl font-bold mt-2">{t.intro.name}</h1>
            <h2 class="text-xl my-2">{t.intro.headline}</h2>
            <SocialButtons variant="social" />
        </div>
    </div>

    <!-- "Scroll" Invitation -->
    <div class="place-items-center">
        <p class="text-2xl font-light">{t.intro.scroll}</p>
        <Icon icon={ICONS.angles_down} size="dxl" classname="text-secondary animate-pulse" />
    </div>
</section>