---
import Technology from "@badges/Technology.astro";
import { TECHNOLOGIES } from "@config/assets";
import type { TechnologiesCoreSubheadersType } from "@typing/AssetsType";

const t = Astro.locals.t.stack.core;
const subheader = Astro.props.subheader as TechnologiesCoreSubheadersType;
---

<div class="flex flex-col gap-2">
    <h3 class="text-lg font-semibold">
        {t.subheaders[subheader]}
    </h3>
    <div class="flex flex-wrap gap-2 pl-2">
        {Object.values(TECHNOLOGIES)
        .filter((tech) => tech.hierarchy.subheader === subheader)
        .map((tech) => (
            <Technology selection={tech} key={tech.metadata.key} />
        ))}
    </div>
</div>