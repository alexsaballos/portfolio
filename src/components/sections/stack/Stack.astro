---
import Title from "@text/Title.astro";
import CoreSubheader from "@sections/stack/CoreSubheader.astro";
import ProductionSubheader from "@sections/stack/ProductionSubheader.astro";
import type {
    TechnologiesCoreSubheadersType, TechnologiesProductionSubheadersType
} from "@typing/AssetsType";

const t = Astro.locals.t.stack;

// Subheaders keys
const coreSubheaders1: TechnologiesCoreSubheadersType[] = ["embedded", "software"];
const coreSubheaders2: TechnologiesCoreSubheadersType = "cad";
const productionSubheaders1: TechnologiesProductionSubheadersType = "web";
const productionSubheaders2: TechnologiesProductionSubheadersType[] = ["frameworks", "databases"];
const productionSubheaders3: TechnologiesProductionSubheadersType = "operations";
const productionSubheaders4: TechnologiesProductionSubheadersType = "api";
---

<section data-aos="fade-up" class="bg-base-300 rounded-4xl py-10 px-5 lg:px-30">
    <div data-aos="fade-up"><Title title={t.title} /></div>
    <div class="grid gap-10 xl:px-10">

        <!-- ================= CORE ================= -->
        <div class="group grid gap-6">
            <h2 class="text-2xl font-bold tracking-tight mt-4">{t.core.header}</h2>
            <div class="flex flex-col flex-wrap gap-6">

                <!-- Embedded & Software Subheaders -->
                <div data-aos="fade-up" class="flex flex-col lg:flex-row gap-6">
                    {Object.values(coreSubheaders1).map(entry => (
                        <CoreSubheader subheader={entry} />
                    ))}
                </div>

                <!-- CAD Subheader -->
                <div data-aos="fade-up">
                    <CoreSubheader subheader={coreSubheaders2} />
                </div>
            </div>
        </div>

        <!-- ============== PRODUCTION ============== -->
        <div class="group grid gap-3 mt-4">
            <h2 data-aos="fade-up" class="text-2xl font-bold tracking-tight">{t.production.header}</h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

                <!-- Web Subheader -->
                <div data-aos="fade-up">
                    <ProductionSubheader subheader={productionSubheaders1} />
                </div>

                <!-- Frameworks & Databases Subheaders -->
                <div data-aos="fade-up" class="flex lg:flex-col gap-6 lg:gap-y-14 xl:gap-y-5">
                    {Object.values(productionSubheaders2).map(entry => (
                        <ProductionSubheader subheader={entry} />
                    ))}
                </div>

                <!-- Operations Subheader -->
                <div data-aos="fade-up">
                    <ProductionSubheader subheader={productionSubheaders3} />
                </div>

                <!-- API Subheader -->
                <div data-aos="fade-up">
                    <ProductionSubheader subheader={productionSubheaders4} />
                </div>

            </div>
        </div>

    </div>
</section>