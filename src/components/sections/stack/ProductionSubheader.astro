---
import { TECHNOLOGIES } from "../../../config/assets";
import type { TechnologiesProductionSubheadersType } from "../../../types/AssetsType";
import type { LocalesType } from "../../../types/LocalesType";
import Technology from "../../ui/Technology.astro";

const { t } = Astro.locals as { t: LocalesType; };
const { subheader } = Astro.props as { subheader: TechnologiesProductionSubheadersType }
---

<fieldset class="fieldset bg-base-100 border border-base-100 rounded-xl p-4">
    <legend class="fieldset-legend text-[15px] font-medium">
        {t.stack.production.subheaders[subheader]}
    </legend>
    <div class="flex flex-wrap gap-2 -mt-2">
        {Object.values(TECHNOLOGIES)
        .filter((tech) => tech.hierarchy.subheader === subheader)
        .map((tech) => (
            <Technology selection={tech} key={tech.metadata.key} />
        ))}
    </div>
</fieldset>