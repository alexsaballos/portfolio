---
import Title from "@text/Title.astro";
import CommonIcon from "@ui/CommonIcon.astro";
import SocialButtons from "@buttons/SocialButtons.astro";
import ContactStatus from "@sections/contact/ContactStatus.astro";
import type { subjectOptionsType } from "@src/types/pages/ContactType";

const t = Astro.locals.t.contact;
const subjects = {
    recruiting: "Recruiting / Hiring",
    technical: "Technical Collaboration",
    business: "Business Inquiry",
    interview: "Interview / Speaking Request",
    academic: "Academic / Educational",
    consulting: "Advisory / Consulting",
    webmaster: "Webmaster Inquiries",
    other: "Other"
};
---

<section data-aos="fade-up" class="p-5 gap-5">
    <ContactStatus />
    <div id="contact_form" class="group">
        <Title title={t.CTA} />
        <div class="justify-items-center">
            <div class="flex flex-col">
                <span class="badge badge-sm badge-success badge-outline bg-success/30 text-success justify-center rounded-full text-xs font-semibold gap-1 mt-3">
                    <CommonIcon name="shield" size="xs" />
                    <span>{t.exclusive}</span>
                </span>
            </div>
            <p class="mt-4 text-base-content/70">{t.form_invite}</p>
            <form enctype="application/x-www-form-urlencoded">
                <fieldset class="fieldset bg-base-200 border border-base-300 rounded-xl w-xs p-4">
                    <legend class="fieldset-legend">{t.required}</legend>

                    <!-- Name input on contact form -->
                    <label for="contactFormName" class="label">
                        <CommonIcon name="id_card" />
                        {t.name.label}
                    </label>
                    <input id="contactFormName" name="name" required type="text"
                        class="input mb-4" placeholder={t.name.placeholder} autocomplete="name" />

                    <!-- Email input on contact form -->
                    <label for="contactFormEmail" class="label">
                        <CommonIcon name="at" />
                        {t.email.label}
                    </label>
                    <input id="contactFormEmail" name="email" required type="email"
                        class="input mb-4" placeholder={t.email.placeholder} autocomplete="email" />

                    <!-- Subject selection on contact form -->
                    <label for="contactFormSubject" class="label">
                        <CommonIcon name="list" />
                        {t.subject.label}
                    </label>
                    <select id="contactFormSubject" name="subject" required class="select mb-4">
                        <option disabled selected>{t.subject.options.placeholder}</option>
                        {Object.entries(subjects).map(([key, value]) =>
                            <option value={value}>{t.subject.options[key as subjectOptionsType]}</option>
                        )}
                    </select>

                    <!-- Message input on contact form -->
                    <label for="contactFormMessage" class="label">
                        <CommonIcon name="message" />
                        {t.message.label}
                    </label>
                    <textarea id="contactFormMessage" required name="message" class="textarea h-48 sm:w-140 lg:w-160"
                        placeholder={t.message.placeholder}></textarea>

                    <!-- Submission button on contact form -->
                    <button type="submit" aria-label={t.send}
                        class="btn btn-primary rounded-4xl place-self-center shadow-none transition-transform duration-300 ease-in-out hover:btn-secondary hover:font-bold hover:scale-105 w-45 mt-4">
                        <CommonIcon name="paper_plane" />
                        {t.send}
                    </button>
                </fieldset>
            </form>
            <div class="flex flex-col sm:flex-row justify-center sm:gap-4 mt-4 mb-2">
                <p class="place-self-center">{t.reach_on}</p>
                <div class="sm:border-l-4 border-secondary"></div>
                <div class="flex flex-row justify-center mt-2 sm:mt-0 sm:-ml-1 gap-2">
                    <SocialButtons variant="contact" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Client-side JS that controls contact-info email sending responses thorugh toast alerts -->
<script src="@scripts/pages/contact.ts"></script>