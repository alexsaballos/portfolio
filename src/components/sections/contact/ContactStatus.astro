---
import { ICONS } from "../../../config/assets";
import type { LocalesType } from "../../../types/LocalesType";
import Icon from "../../ui/libraries/Icon.astro";

const { t } = Astro.locals as { t: LocalesType }
---
 <!-- Status toasts triggered via client-side JS -->
<div id="toast_contact" class="toast toast-center toast-top mt-3 md:mt-17 z-998">
    <div id="toast_loading" role="alert" class="hidden alert alert-info rounded-4xl transition-transform duration-500 ease-out hover:scale-120">
        <Icon icon={ICONS.spinner} size="sm" classname="animate-spin" />
        {t.contact.alerts.loading}
    </div>
    <div id="toast_error" role="alert" class="hidden alert alert-error rounded-4xl transition-transform duration-500 ease-out hover:scale-120">
        <Icon icon={ICONS.circle_xmark} size="sm" />
        {t.contact.alerts.failure}
    </div>
</div>

<!-- Sucess screen that replaces the contact form on successful operation -->
<div id="success_screen" class="hidden flex flex-col text-center place-items-center gap-4 pt-6 pb-16 px-2">
    <Icon icon={ICONS.envelope_check} size="ixl" classname="text-emerald-700" />
    <p class="text-3xl font-bold">{t.contact.alerts.success.p1}</p>
    <p class="text-xl">{t.contact.alerts.success.p2}</p>
</div>