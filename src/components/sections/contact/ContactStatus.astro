---
import { ICONS } from "@config/assets";
import Icon from "@libraries/Icon.astro";
import Title from "@text/Title.astro";

const t = Astro.locals.t.contact.alerts;
---
 <!-- Status toasts triggered via client-side JS -->
<div id="toast_contact" class="toast toast-center toast-top mt-3 md:mt-17 z-999">
    <div id="toast_loading" role="alert" class="hidden alert alert-info rounded-4xl transition-transform duration-500 ease-out hover:scale-120">
        <Icon icon={ICONS.spinner} size="sm" classname="animate-spin" />
        {t.loading}
    </div>
    <div id="toast_error" role="alert" class="hidden alert alert-error rounded-4xl transition-transform duration-500 ease-out hover:scale-120">
        <Icon icon={ICONS.circle_xmark} size="sm" />
        {t.failure}
    </div>
</div>

<!-- Sucess screen that replaces the contact form on successful operation -->
<section data-aos="fade-in" id="success_screen" class="hidden flex flex-col text-center place-items-center gap-4 py-25 md:py-10 px-5">
    <Icon icon={ICONS.envelope_check} size="exl" />
    <Title title={t.success.p1} />
    <h2 class="text-2xl font-light">{t.success.p2}</h2>
</section>