---
import { ASSETS } from "../../config/assets";
import Technology from "../ui/Technology.astro";
---

<section class="bg-base-300 rounded-4xl py-10 px-5 lg:px-30">
    <div class="grid gap-10 xl:px-10">
        <!-- ================= Tier 1 ================= -->
        <section class="grid gap-6">
            <h2 class="text-2xl font-bold tracking-tight">Core Engineering</h2>
            <div class="flex flex-col flex-wrap gap-6">

                <div class="flex flex-col lg:flex-row gap-6">
                    <!-- Embedded -->
                    <div class="flex flex-col gap-2">
                        <h3 class="text-lg font-semibold">Embedded & Robotics Systems</h3>
                        <div class="flex flex-wrap gap-2 pl-2">
                            <Technology selection={ASSETS.technologies.baremetal} />
                            <Technology selection={ASSETS.technologies.kicad} />
                            <Technology selection={ASSETS.technologies.ultiboard} />
                            <Technology selection={ASSETS.technologies.multisim} />
                            <Technology selection={ASSETS.technologies.opencv} />
                            <Technology selection={ASSETS.technologies.raspberrypi} />
                            <Technology selection={ASSETS.technologies.arduino} />
                        </div>
                    </div>

                    <!-- Software -->
                    <div class="flex flex-col gap-2">
                        <h3 class="text-lg font-semibold">Software Engineering</h3>
                        <div class="flex flex-wrap gap-2 pl-2">
                            <Technology selection={ASSETS.technologies.c} />
                            <Technology selection={ASSETS.technologies.cpp} />
                            <Technology selection={ASSETS.technologies.csharp} />
                            <Technology selection={ASSETS.technologies.java} />
                            <Technology selection={ASSETS.technologies.python} />
                            <Technology selection={ASSETS.technologies.javascript} />
                            <Technology selection={ASSETS.technologies.typescript} />
                            <Technology selection={ASSETS.technologies.php} />
                        </div>
                    </div>                        
                </div>

                <!-- CAD -->
                <div class="flex flex-col gap-2">
                    <h3 class="text-lg font-semibold">Engineering CAD</h3>
                    <div class="flex flex-wrap gap-2 pl-2">
                        <Technology selection={ASSETS.technologies.autocad} />
                        <Technology selection={ASSETS.technologies.sketchup} />
                    </div>
                </div>

            </div>
        </section>

        <!-- ================= Tier 2 ================= -->
        <section class="grid gap-6 mt-4">
            <h2 class="text-xl font-semibold -mb-4">Supporting Expertise</h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

                <!-- Web -->
                <fieldset class="fieldset bg-base-100 border border-base-100 rounded-xl p-4">
                    <legend class="fieldset-legend text-[15px] font-medium">Web & UI</legend>
                    <div class="flex flex-wrap gap-2 -mt-2">
                        <Technology selection={ASSETS.technologies.html} />
                        <Technology selection={ASSETS.technologies.css} />
                        <Technology selection={ASSETS.technologies.astro} />
                        <Technology selection={ASSETS.technologies.react} />
                        <Technology selection={ASSETS.technologies.tailwindcss} />
                        <Technology selection={ASSETS.technologies.daisyui} />
                        <Technology selection={ASSETS.technologies.antdesign} />
                        <Technology selection={ASSETS.technologies.axios} />
                    </div>
                </fieldset>

                <!-- Frameworks & Databases -->
                <div class="flex lg:flex-col gap-6 lg:gap-y-14 xl:gap-y-5">
                    <!-- Frameworks -->
                    <fieldset class="fieldset bg-base-100 border border-base-100 rounded-xl p-4">
                        <legend class="fieldset-legend text-[15px] font-medium">Frameworks</legend>
                        <div class="flex flex-wrap gap-2 -mt-2">
                            <Technology selection={ASSETS.technologies.flask} />
                            <Technology selection={ASSETS.technologies.winui} />
                        </div>
                    </fieldset>

                    <!-- Databases -->
                    <fieldset class="fieldset bg-base-100 border border-base-100 rounded-xl p-4">
                        <legend class="fieldset-legend text-[15px] font-medium">Databases</legend>
                        <div class="flex flex-wrap gap-2 -mt-2">
                            <Technology selection={ASSETS.technologies.mysql} />
                            <Technology selection={ASSETS.technologies.sqlite} />
                        </div>
                    </fieldset>
                </div>

                <!-- Admin -->
                <fieldset class="fieldset bg-base-100 border border-base-100 rounded-xl p-4">
                    <legend class="fieldset-legend text-[15px] font-medium">Administration</legend>
                    <div class="flex lg:flex-col flex-wrap gap-2 -mt-2">
                        <Technology selection={ASSETS.technologies.directus} />
                        <Technology selection={ASSETS.technologies.cpanel} />
                        <Technology selection={ASSETS.technologies.phpmyadmin} />
                    </div>
                </fieldset>

            </div>
        </section>

    </div>
</section>