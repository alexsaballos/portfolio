---
import { ICONS } from "../../config/assets";
import Icon from "../ui/libraries/Icon.astro";

const t = Astro.locals.t;
---

<section class="flex flex-col font-light text-center place-items-center gap-4 py-30 md:py-10 px-5">
    <Icon icon={ICONS.hourglass} size="exl" classname="animate-pulse text-center" />
    <h1 class="text-6xl">{t.coming_soon.p1}</h1>
    <h2 class="text-3xl">{t.coming_soon.p2}</h2>
</section>