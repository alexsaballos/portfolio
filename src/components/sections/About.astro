---
import type { Translations } from "../../types/locales";
import Technologies from "../ui/Technologies.astro";

const { t } = Astro.locals as { t: Translations };
---

<section class="hero bg-base-100 py-10 px-5">
    <div class="flex flex-col md:flex-row w-full gap-4">
        <div class="flex flex-1 flex-col gap-4">
            <h1 class="text-4xl text-center font-bold">{t.about.greeting}</h1>
            <p>{t.about.introduction}</p>
        </div>
        <div class="divider"></div>
        <div class="flex flex-1 flex-col">
            <Technologies />
        </div>
    </div>
</section>