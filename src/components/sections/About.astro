---
import type { LocalesType } from "../../types/LocalesType";

const { t } = Astro.locals as { t: LocalesType };
---

<section class="bg-base-100 py-10 px-5">
    <header class="flex flex-col gap-5 items-center text-center">
        <h1 class="text-5xl font-bold">{t.about.greeting}</h1>
        <p class="max-w-5xl">{t.about.introduction}</p>
    </header>
</section>