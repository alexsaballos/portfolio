---
import { ASSETS } from "../../../config/assets";
import { PERSONAL } from "../../../config/personal";
import type { Translations } from "../../../types/locales";

import Icon from "../../ui/Icon.astro";

const { t } = Astro.locals as { t: Translations };
---

<div class="px-1 bg-base-100 items-center justify-around gap-1">
    <div class="flex flex-row items-center justify-center gap-2">
        <Icon icon={ASSETS.icons.devices} classname="text-primary" />
        <p class="align-middle text-base-content text-xs">
            Copyright &copy; {new Date().getFullYear()} - {PERSONAL.short_name} - {t.footer.copyright}
        </p>
    </div>
</div>