---
import { ICONS } from "../../../config/assets";
import type { LocalesType } from "../../../types/LocalesType";

import Icon from "../../ui/libraries/Icon.astro";

const { t } = Astro.locals as { t: LocalesType };
---

<div class="px-1 bg-base-100 items-center justify-around gap-1">
    <div class="flex flex-row items-center justify-center gap-2">
        <Icon icon={ICONS.devices} classname="text-primary" />
        <p class="align-middle text-base-content text-xs">
            Copyright &copy; {new Date().getFullYear()} - {t.footer.copyright}
        </p>
    </div>
</div>