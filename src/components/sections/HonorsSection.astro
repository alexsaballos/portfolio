---
import { ICONS } from "../../config/assets";
import { HONOR_LINKS, HONORS_KEYS } from "../../config/honors";

import Title from "../ui/text/Title.astro";
import Icon from "../ui/libraries/Icon.astro";
import Image from "astro/components/Image.astro";

import type { HonorsOrgListType, HonorsListType, HonorsLinkType, FlatHonorLinks, NestedHonorLinks } from "../../types/HonorsType";

const t = Astro.locals.t;

// Type-aware award discriminator
function isFlatOrg(org: FlatHonorLinks | NestedHonorLinks): org is FlatHonorLinks
	{ return ("link" in org) || ("verification" in org); }

// Type-aware URL getter through discriminator
function resolveHonorResource(
	organization: HonorsOrgListType,
	awardKey: HonorsListType,
	type: HonorsLinkType
): (string | undefined) {
	const org = HONOR_LINKS[organization];
	return (isFlatOrg(org)) ? org[type] : org[awardKey]?.[type];
}

// Type-aware Year getter through discriminator
function resolveHonorYear(
	organization: HonorsOrgListType,
	awardKey: HonorsListType
): (string | undefined) {
	const org = HONOR_LINKS[organization];
	return (isFlatOrg(org)) ? org.year : org[awardKey]?.year;
}
---

<section class="pb-10 px-5 lg:px-10 xl:px-20">
	<Title title={t.honors.texts.title} classname="mt-4 mb-8" />

	<div class="gap-6 flex flex-col lg:grid lg:grid-cols-2 lg:grid-rows-2">
		{HONORS_KEYS.map((organization, i) => (
			<div class={`bg-base-200 rounded-4xl p-6 ring-4 ring-gray-500 relative
				${(i === 0) ? "lg:col-start-1 lg:row-start-1" : ""}
				${(i === 1) ? "lg:col-start-1 lg:row-start-2" : ""}
				${(i === 2) ? "lg:col-start-2 lg:row-start-1 lg:row-span-2" : ""}`}>

				<Image src={HONOR_LINKS[organization].picture} alt={`${t.honors[organization].name} Logo`}
					class="w-full rounded-2xl place-self-center max-h-40 max-w-120" />

				<h3 class="text-xl text-secondary font-bold my-4">{t.honors[organization].name}</h3>
				<ul class="space-y-4">
					{t.honors[organization].awards.map(award => (
						<li>							
							<p class="font-medium">{`${award.title} [${resolveHonorYear(organization, award.key)}]`}</p>

							<details class="group">
								<summary class="list-none cursor-pointer">
									<p class="text-sm text-base-content/70 group-open:hidden">{award.summary}</p>
									<span class="flex flex-row gap-2 text-sm text-secondary my-1 group-open:hidden hover:underline">
										{t.honors.texts.description}
										<Icon icon={ICONS.angles_down} size="xs" classname="mt-0.5" />
									</span>
								</summary>
								<p class="text-sm text-base-content/70 mt-2">{award.details}</p>
							</details>
							
							{(award.link || award.verification) && (
								<div class="flex flex-row flex-wrap items-center gap-2 my-2">
									<p class="text-xs tracking-wide leading-none uppercase text-base-content/60">
										{t.honors.texts.resources}
									</p>
									<div class="flex flex-wrap gap-2">
										{award.verification && (() => {
											const url = resolveHonorResource(organization, award.key, "verification");
											return url && (
												<a href={url} target="_blank" rel="noopener noreferrer"
													class="badge badge-accent badge-sm rounded-4xl transition-transform duration-500 ease-out hover:scale-105 hover:opacity-70" >
													<Icon icon={ICONS.certifications} size="xs" />
													{award.verification.name}
												</a>
											);
										})()}
										{award.link && (() => {
											const url = resolveHonorResource(organization, award.key, "link");
											return url && (
												<a href={url} target="_blank" rel="noopener noreferrer"
													class="badge badge-primary badge-sm rounded-4xl transition-transform duration-500 ease-out hover:scale-105 hover:opacity-70">
													<Icon icon={ICONS.link} size="xs" />
													{award.link.name}
												</a>
											);
										})()}
									</div>
								</div>
							)}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</section>