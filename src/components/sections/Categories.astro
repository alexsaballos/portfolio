---
import { ASSETS } from "../../config/assets"
import type { Translations } from "../../types/locales"
import Image from "astro/components/Image.astro"
import Icon from "../ui/Icon.astro"

const { t } = Astro.locals as {
    t: Translations
}

const CATEGORIES = {
    projects: {
        link: "#",
        picture: ASSETS.pictures.categories.projects,
        icon: ASSETS.icons.projects,
        description: t.categories.projects
    },
    experience: {
        link: "#",
        picture: ASSETS.pictures.categories.experience,
        icon: ASSETS.icons.experience,
        description: t.categories.experience
    },
    leadership: {
        link: "#",
        picture: ASSETS.pictures.categories.leadership,
        icon: ASSETS.icons.leadership,
        description: t.categories.leadership
    },
    certifications: {
        link: "#",
        picture: ASSETS.pictures.categories.certifications,
        icon: ASSETS.icons.certifications,
        description: t.categories.certifications
    },
    honors: {
        link: "#",
        picture: ASSETS.pictures.categories.honors,
        icon: ASSETS.icons.honors,
        description: t.categories.honors
    }
}
---

<section class="bg-base-100 pt-15 pb-10 px-5 rounded-4xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 md:gap-y-12 md:gap-x-5 lg:gap-x-5 lg:gap-y-12">
        {Object.values(CATEGORIES).map((category, i) => (
            <div class={`relative w-full ${(i === 0) ? "md:col-span-2" : "block"}`}>
                <div class="absolute -top-7.5 left-1/2 -translate-x-1/2 z-1">
                    <div class="rounded-full bg-primary p-3 shadow-none">
                        <Icon icon={category.icon} size="md" classname="text-white" />
                    </div>
                </div>
                <a href={category.link}>
                    <div class="card image-full rounded-2xl h-64 md:h-72 lg:h-80 group hover:ring-6 hover:ring-primary">
                        <figure>
                            <Image src={category.picture} alt={category.description}
                                    class="transition-transform duration-500 ease-out group-hover:scale-110" />
                        </figure>
                        <div class="absolute w-full h-full rounded-2xl bg-black/30 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
                        <div class="card-body flex items-center justify-center relative">
                            <div class="card-title text-2xl place-content-center text-white group-hover:font-bold group-hover:border-b-4 group-hover:border-secondary">
                                {category.description}
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        ))}
    </div>
</section>