---
import { PROJECTS } from "@config/pages/projects";
import Title from "@src/components/ui/text/Title.astro";
import SearchBar from "@sections/projects/SearchBar.astro";
import HeroCard from "@sections/projects/HeroCard.astro";
import GridCard from "@sections/projects/GridCard.astro";

const t = Astro.locals.t.projects;

const projects = Object.values(PROJECTS);
const softwareHero = projects.find(p => p.featured && p.discipline === "software_engineering")!;
const electricalHero = projects.find(p => p.featured && p.discipline === "electrical_engineering")!;

const softwareProjects = projects.filter(p => p.key !== softwareHero.key && p.discipline === "software_engineering");
const electricalProjects = projects.filter(p => p.key !== electricalHero.key && p.discipline === "electrical_engineering");
---

<section class="container mx-auto max-w-7xl px-4 pb-10 space-y-10">
    <!-- SEARCH BAR -->
    <!-- <div class="flex flex-col items-center-safe">
        <Title title="My projects" classname="mt-4 mb-8" />
        <SearchBar />
    </div> -->

    <!-- ELECTRICAL ENGINEERING -->
    <section class="space-y-10">
        <div class="group pt-5">
            <h2 class="text-4xl font-bold">{t.texts.electrical.title}</h2>
            <p class="mt-2 max-w-2xl opacity-70">{t.texts.electrical.description}</p>
        </div>

        <HeroCard discipline="electrical" heroProj={electricalHero} id="electrical-hero" />
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {electricalProjects.map(project => <GridCard project={project} />)}
        </div>
    </section>

    <!-- SOFTWARE ENGINEERING -->
    <section class="space-y-10">
        <div class="group pt-5">
            <h2 class="text-4xl font-bold">{t.texts.software.title}</h2>
            <p class="mt-2 max-w-2xl opacity-70">{t.texts.software.description}</p>
        </div>

        <HeroCard discipline="software" heroProj={softwareHero} id="software-hero" />
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {softwareProjects.map(project => <GridCard project={project} />)}
        </div>
    </section>
</section>

<!-- Client-side JS that controls project filtering and searching -->
