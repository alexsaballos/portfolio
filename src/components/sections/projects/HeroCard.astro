---
import Image from "astro/components/Image.astro";
import CommonIcon from "@src/components/ui/CommonIcon.astro";
import { TECHNOLOGIES } from "@src/config/assets";
import type { ProjectType } from "@src/types/pages/ProjectsType";

const hero = Astro.props.hero as ProjectType;
const t = Astro.locals.t.projects;
---

<article data-aos="zoom-in" class="hero rounded-box border border-base-300 bg-base-200 overflow-hidden">
    <div class="hero-content flex-col lg:flex-row-reverse gap-10 p-8">
        <Image src={hero.images.cover} alt={t[hero.key].title} class="aspect-video w-full max-w-2xl rounded-2xl object-cover shadow-xl" />

        <div class="flex-1">
            <div class="mb-3 flex flex-wrap gap-2">
                <div class="badge badge-primary rounded-full">{t.texts.featured}</div>
                <div class="badge badge-outline rounded-full">{t.texts.client[hero.client]}</div>
                <div class="badge badge-outline rounded-full">{t.texts.status[hero.status]}</div>
                <div class="badge badge-outline rounded-full">{t.texts.privacy[hero.privacy]}</div>
            </div>

            <h3 class="text-3xl sm:text-5xl font-bold">{t[hero.key].title}</h3>

            <div class="mt-3 text-sm opacity-60">
                {hero.startDate}
                {hero.endDate && ` \u2192 ${hero.endDate}`}
            </div>

            <p class="mt-6 opacity-75">{t[hero.key].summary}</p>

            <div class="mt-6 flex flex-wrap gap-2">
                {hero.categories.map(category => (
                    <span class="badge badge-secondary">{t.texts.categories[category]}</span>
                ))}
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
                {hero.stack.map(tech => (
                    <span class="badge badge-neutral badge-sm gap-1 py-3.5 text-xs rounded-full align-middle">
                        <CommonIcon name={tech} size="md" />
                        {TECHNOLOGIES[tech].visual.name}
                    </span>
                ))}
            </div>
        </div>
    </div>
</article>