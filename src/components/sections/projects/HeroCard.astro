---
import Image from "astro/components/Image.astro";
import CommonIcon from "@src/components/ui/CommonIcon.astro";
import { TECHNOLOGIES } from "@src/config/assets";
import type { ProjectType } from "@src/types/pages/ProjectsType";

const { discipline, heroProj } = Astro.props as {
    discipline: "electrical" | "software";
    heroProj: ProjectType;
};
const t = Astro.locals.t.projects;
---

<article data-aos="zoom-in" class="hero rounded-xl border border-base-300 bg-base-300 overflow-hidden">
    <div class={`hero-content flex-col ${(discipline === "electrical") ? "lg:flex-row-reverse" : "lg:flex-row"} gap-10 p-8`}>
        <Image src={heroProj.images.cover} alt={t[heroProj.key].title} class="aspect-video w-full max-w-2xl rounded-2xl object-cover shadow-2xl" />

        <div class="flex-1">
            <div class="mb-3 flex flex-wrap gap-2">
                <div class="badge badge-primary rounded-full">{t.texts.featured}</div>
                <div class="badge badge-outline rounded-full">{t.texts.client[heroProj.client]}</div>
                <div class="badge badge-outline rounded-full">{t.texts.privacy[heroProj.privacy]}</div>
                <div class="badge badge-outline rounded-full">{t.texts.status[heroProj.status]}</div>
            </div>

            <h3 class="text-3xl sm:text-5xl font-bold">{t[heroProj.key].title}</h3>
            <p class="mt-3 text-sm opacity-60">{heroProj.startDate}{heroProj.endDate && ` \u2192 ${heroProj.endDate}`}</p>
            <p class="mt-6 opacity-75">{t[heroProj.key].summary}</p>

            <div class="mt-6 flex flex-wrap gap-2">
                {heroProj.categories.map(category => (
                    <span class="badge badge-sm badge-secondary">{t.texts.categories[category]}</span>
                ))}
            </div>

            {heroProj.hardware &&
                <div class="mt-6 flex flex-wrap gap-2">
                    {heroProj.hardware.map(hardware => (
                        <span class="badge badge-sm badge-primary">{t.texts.hardware[hardware]}</span>
                    ))}
                </div>
            }

            <div class="mt-6 flex flex-wrap gap-2">
                {heroProj.stack.map(tech => (
                    <span class="badge badge-sm badge-ghost rounded-full align-middle gap-1 py-2.5">
                        <CommonIcon name={tech} size="sm" />
                        {TECHNOLOGIES[tech].visual.name}
                    </span>
                ))}
            </div>
        </div>
    </div>
</article>