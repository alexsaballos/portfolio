---
import CommonIcon from "@src/components/ui/CommonIcon.astro";

const t = Astro.locals.t.projects;
---

<div class="w-full flex flex-col justify-center rounded-4xl border border-base-300 bg-base-100 gap-4 p-4 shadow-sm">

    <label class="input input-xl rounded-full mx-auto sm:w-100 md:w-150 lg:w-200">
        <CommonIcon name="search" />
        <input required id="project-search" type="search" class="grow" placeholder={t.texts.search.placeholder} />
    </label>

    <div class="flex flex-wrap justify-center gap-4 lg:flex-row lg:items-end">

        <!-- Discipline -->
        <label class="form-control flex flex-col w-full lg:w-56">
            <span class="label label-text font-semibold pb-1">{t.texts.search.discipline}</span>
            <select id="project-discipline" class="select rounded-lg">
                <option value="all">{t.texts.search.todas}</option>
                {Object.entries(t.texts.disciplines).map(([key, value]) => 
                    <option value={key}>{value}</option>
                )}
            </select>
        </label>

        <!-- Status -->
        <label class="form-control flex flex-col w-full lg:w-44">
            <span class="label label-text font-semibold pb-1">{t.texts.search.status}</span>
            <select id="project-status" class="select rounded-lg">
                <option value="all">{t.texts.search.todos}</option>
                {Object.entries(t.texts.status).map(([key, value]) => 
                    <option value={key}>{value}</option>
                )}
            </select>
        </label>

        <!-- Organization -->
        <label class="form-control flex flex-col w-full lg:w-56">
            <span class="label label-text font-semibold pb-1">{t.texts.search.organization}</span>
            <select id="project-organization" class="select rounded-lg">
                <option value="all">{t.texts.search.todas}</option>
                {Object.entries(t.texts.organization).map(([key, value]) => 
                    <option value={key}>{value}</option>
                )}
            </select>
        </label>

        <!-- Featured Only -->
        <label class="flex flex-col cursor-pointer gap-3">
            <span class="label label-text font-semibold">{t.texts.search.featured}</span>
            <input id="project-featured" type="checkbox" class="checkbox checkbox-primary" />
        </label>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <button id="project-clear" type="button" class="btn btn-sm btn-ghost">
            {t.texts.search.clear}
        </button>
    </div>
</div>