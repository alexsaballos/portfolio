---
import Image from "astro/components/Image.astro";
import CommonIcon from "@ui/CommonIcon.astro";
import { TECHNOLOGIES } from "@config/assets";
import type { ProjectType } from "@typing/pages/ProjectsType";

const project = Astro.props.project as ProjectType;
const t = Astro.locals.t.projects;

const BADGE_LIMIT = 3;
const visibleStack = project.stack.slice(0, BADGE_LIMIT);
const hiddenStack = project.stack.slice(BADGE_LIMIT);
const hasMoreTech = hiddenStack.length > 0;
---

<!-- Project-card class used on client-side JS project filtering -->
<article data-aos="fade-up"
    class="project-card rounded-lg ring-1 ring-base-content/10 relative border border-base-300 bg-base-100 shadow-sm hover:shadow-lg transition-shadow flex flex-col"
    data-project_title={t[project.key].title.toLowerCase()}
    data-project_discipline={project.discipline}
    data-project_status={project.status}
    data-project_stack={project.stack}
    data-project_organization={project.organization}
    data-project_featured={project.featured}>
    
    <!-- Banner Image & Completion Tags -->
    <Image src={project.images.cover} alt={t[project.key].title} class="rounded-t-lg aspect-video w-full object-cover select-none" />
    <span class="absolute top-3 right-3 badge badge-success badge-sm rounded-full select-none bg-success/60 font-semibold">
        {t.texts.status[project.status]}
    </span>

    <!-- Title, organization, dates, categories, and tech stack -->
    <div class="group p-3">
        <h3 class="text-lg text-secondary font-semibold">{t[project.key].title}</h3>
        <h4 class="text-md tracking-wider text-base-content/70 font-thin">{t.texts.organization[project.organization]}</h4>

        <div class="flex flex-wrap gap-2 my-4">
            <span class="badge badge-info badge-sm rounded-full select-none font-semibold">
                {project.startDate}
                {(project.endDate && project.startDate !== project.endDate) ? ` \u2192 ${project.endDate}` : ""}
            </span>
            <!-- Handles edge case ocurring when organization === client === "personal" -->
            {(project.organization !== project.client) &&
                <span class="badge badge-info badge-sm rounded-full select-none badge-outline bg-info/20 font-semibold">
                    {t.texts.client[project.client]}
                </span>
            }
            <span class="badge badge-info badge-sm rounded-full select-none badge-outline font-semibold">
                {t.texts.privacy[project.privacy]}
            </span>
        </div>
        <p class="text-sm text-base-content/70 line-clamp-2">{t[project.key].summary}</p>

        <div class="flex flex-col gap-2 my-4">
            <p class="text-xs tracking-wide leading-none uppercase text-base-content/60">{t.texts.categories.header}</p>
            <div class="flex flex-wrap gap-2">
                {project.categories.map(category => (
                    <span class="badge badge-sm badge-outline badge-secondary hover:bg-secondary hover:text-secondary-content rounded-md transition-colors duration-250">
                        {t.texts.categories[category]}
                    </span>
                ))}
            </div>
        </div>

        {project.hardware && 
            <div class="flex flex-col gap-2 my-4">
                <p class="text-xs tracking-wide leading-none uppercase text-base-content/60">{t.texts.hardware.header}</p>
                <div class="flex flex-wrap gap-2">
                    {project.hardware.map(hardware => (
                        <span class="badge badge-sm badge-outline badge-primary hover:bg-primary hover:text-primary-content rounded-md transition-colors duration-250">
                            {t.texts.hardware[hardware]}
                        </span>
                    ))}
                </div>
            </div>
        }

        <div class="flex flex-col gap-2 mt-4 mb-2">
            <p class="text-xs tracking-wide leading-none uppercase text-base-content/60">{t.texts.stack.header}</p>
            <div class="flex flex-wrap gap-2">
                {visibleStack.map(tech => (
                    <span class="badge badge-sm badge-ghost rounded-md align-middle gap-1">
                        <CommonIcon name={tech} size="sm" />
                        {TECHNOLOGIES[tech].visual.name}
                    </span>
                ))}
                {hasMoreTech && (
                    <details class="group inline-block relative">
                        <summary class="badge badge-ghost badge-outline badge-sm rounded-md font-semibold align-middle cursor-pointer list-none select-none mb-2">
                            <span class="group-open:hidden">+{hiddenStack.length} {t.texts.stack.more}</span>
                            <span class="hidden group-open:inline">{t.texts.stack.less}</span>
                        </summary>
                        
                        <div class="absolute bg-base-200 border border-base-300 rounded-box shadow-2xl flex flex-col gap-2 mt-1 p-1 z-10">
                            {hiddenStack.map(tech => (
                                <span class="badge badge-sm badge-ghost rounded-md align-middle gap-1 whitespace-nowrap">
                                    <CommonIcon name={tech} size="sm" />
                                    {TECHNOLOGIES[tech].visual.name}
                                </span>
                            ))}
                        </div>
                    </details>
                )}
            </div>
        </div>
    </div>
</article>