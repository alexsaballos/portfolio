---
import Image from "astro/components/Image.astro";
import CommonIcon from "@src/components/ui/CommonIcon.astro";
import { TECHNOLOGIES } from "@src/config/assets";
import type { ProjectType } from "@src/types/pages/ProjectsType";

const project = Astro.props.project as ProjectType;
const t = Astro.locals.t.projects;
---

<!-- Project-card class used on client-side JS project filtering -->
<article data-aos="fade-up" class="card project-card relative border border-base-300 bg-base-100 shadow-sm hover:shadow-lg transition-shadow"
    data-project_title={t[project.key].title.toLowerCase()}
    data-project_discipline={project.discipline}
    data-project_status={project.status}
    data-project_stack={project.stack}
    data-project_organization={project.organization}
    data-project_featured={project.featured}>
    <Image src={project.images.cover} alt={t[project.key].title} class="rounded-t-lg aspect-video w-full object-cover" />
    <span class="absolute top-3 right-3 badge badge-success badge-sm rounded-full select-none bg-success/60 font-semibold">
        {t.texts.status[project.status]}
    </span>
    <span class="absolute top-3 left-3 badge badge-info badge-sm rounded-full select-none bg-info/60 font-semibold">
        {t.texts.privacy[project.privacy]}
    </span>

    <div class="card-body">
        <h3 class="card-title">{t[project.key].title}</h3>

        <div class="flex flex-wrap gap-2 my-1">
            <span class="badge badge-outline badge-sm rounded-full">
                {project.startDate}
                {(project.endDate && project.startDate !== project.endDate) ? ` \u2192 ${project.endDate}` : ""}
            </span>
            {project.organization !== "personal" &&
                <span class="badge badge-outline badge-sm rounded-full">{t.texts.organization[project.organization]}</span>
            }
            <span class="badge badge-outline badge-sm rounded-full">{t.texts.client[project.client]}</span>
        </div>

        <div class="flex flex-wrap gap-1">
            {project.categories.map(category => (
                <span class="badge badge-ghost badge-sm">{t.texts.categories[category]}</span>
            ))}
        </div>

        <div class="divider my-1" />

        <div class="flex flex-wrap gap-2">
            {project.stack.map(tech => (
                <span class="badge badge-neutral badge-sm rounded-full align-middle gap-1">
                    <CommonIcon name={tech} size="sm" />
                    {TECHNOLOGIES[tech].visual.name}
                </span>
            ))}
        </div>
    </div>
</article>