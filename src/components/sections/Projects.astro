---
import { PROJECTS } from "@config/pages/projects";
import { TECHNOLOGIES } from "@src/config/assets";

import Image from "astro/components/Image.astro";
import Title from "@ui/text/Title.astro";
import CommonIcon from "@ui/CommonIcon.astro";

import type { ProjectType } from "@src/types/pages/ProjectsType"

const t = Astro.locals.t.projects;

const projects = Object.values(PROJECTS);
const softwareHero: ProjectType = projects.find(p => p.featured && p.discipline === "software_engineering")!;
const electricalHero: ProjectType = projects.find(p => p.featured && p.discipline === "electrical_engineering")!;

const softwareProjects = projects.filter(p => p.key !== softwareHero.key && p.discipline === "software_engineering");
const electricalProjects = projects.filter(p => p.key !== electricalHero.key && p.discipline === "electrical_engineering");
---

<section class="container mx-auto max-w-7xl px-4 py-10 space-y-28">
    <!-- Search Bar -->
    <!-- <div class="flex flex-col items-center-safe gap-10">
        <Title title="My projects" />
        <label class="input input-xl rounded-full mx-auto sm:w-100 md:w-150 lg:w-200">
            <CommonIcon name="shield" />
            <input required type="search" placeholder="Search Project" />
        </label>
    </div> -->

    <!-- ELECTRICAL ENGINEERING -->
    <section class="space-y-10">
        <div class="group">
            <h2 class="text-4xl font-bold">{t.texts.electrical.title}</h2>
            <p class="mt-2 max-w-2xl opacity-70">{t.texts.electrical.description}</p>
        </div>

        <!-- HERO -->
        <article data-aos="zoom-in" class="hero rounded-box border border-base-300 bg-base-200 overflow-hidden">
            <div class="hero-content flex-col lg:flex-row-reverse gap-10 p-8">
                <Image src={electricalHero.images.cover} alt={t[electricalHero.key].title} class="aspect-video w-full max-w-2xl rounded-2xl object-cover shadow-xl" />

                <div class="flex-1">
                    <div class="mb-3 flex flex-wrap gap-2">
                        <div class="badge badge-primary rounded-full">{t.texts.featured}</div>
                        <div class="badge badge-outline rounded-full">{t.texts.client[electricalHero.client]}</div>
                        <div class="badge badge-outline rounded-full">{t.texts.status[electricalHero.status]}</div>
                        <div class="badge badge-outline rounded-full">{t.texts.privacy[electricalHero.privacy]}</div>
                    </div>

                    <h3 class="text-3xl sm:text-5xl font-bold">{t[electricalHero.key].title}</h3>

                    <div class="mt-3 text-sm opacity-60">
                        {electricalHero.startDate}
                        {electricalHero.endDate && ` \u2192 ${electricalHero.endDate}`}
                    </div>

                    <p class="mt-6 opacity-75">{t[electricalHero.key].summary}</p>

                    <div class="mt-6 flex flex-wrap gap-2">
                        {electricalHero.categories.map(category => (
                            <span class="badge badge-secondary">{t.texts.categories[category]}</span>
                        ))}
                    </div>

                    <div class="mt-6 flex flex-wrap gap-2">
                        {electricalHero.stack.map(tech => (
                            <span class="badge badge-neutral badge-sm gap-1 py-3.5 text-xs rounded-full align-middle">
                                <CommonIcon name={tech} size="md" />
                                {TECHNOLOGIES[tech].visual.name}
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        </article>

        <!-- GRID -->
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {electricalProjects.map((project: ProjectType) => (
                <article data-aos="fade-up" class="card relative border border-base-300 bg-base-100 shadow-sm hover:shadow-lg transition-shadow">
                    <Image src={project.images.cover} alt={t[project.key].title} class="rounded-t-lg aspect-video w-full object-cover" />
                    <span class="absolute top-3 right-3 badge badge-success badge-sm rounded-full select-none bg-success/60 font-semibold">{t.texts.status[project.status]}</span>
                    <span class="absolute top-3 left-3 badge badge-info badge-sm rounded-full select-none bg-info/60 font-semibold">{t.texts.privacy[project.privacy]}</span>

                    <div class="card-body">
                        <h3 class="card-title">{t[project.key].title}</h3>

                        <div class="flex flex-wrap gap-2 my-1">
                            <span class="badge badge-outline badge-sm rounded-full">
                                {project.startDate}
                                {(project.endDate && project.startDate !== project.endDate) ? ` \u2192 ${project.endDate}` : ""}
                            </span>
                            <span class="badge badge-outline badge-sm rounded-full">{t.texts.client[project.client]}</span>
                        </div>

                        <div class="flex flex-wrap gap-1">
                            {project.categories.map(category => (
                                <span class="badge badge-ghost badge-sm">{t.texts.categories[category]}</span>
                            ))}
                        </div>

                        <div class="divider my-1" />

                        <div class="flex flex-wrap gap-2">
                            {project.stack.map(tech => (
                                <span class="badge badge-neutral badge-sm rounded-full align-middle gap-1">
                                    <CommonIcon name={tech} size="sm" />
                                    {TECHNOLOGIES[tech].visual.name}
                                </span>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </section>

    <!-- SOFTWARE ENGINEERING -->
    <section class="space-y-10">
        <div class="group">
            <h2 class="text-4xl font-bold">{t.texts.software.title}</h2>
            <p class="mt-2 max-w-2xl opacity-70">{t.texts.software.description}</p>
        </div>

        <!-- HERO -->
        <article data-aos="zoom-in" class="hero rounded-box border border-base-300 bg-base-200 overflow-hidden">
            <div class="hero-content flex-col lg:flex-row gap-10 p-8">
                <Image src={softwareHero.images.cover} alt={t[softwareHero.key].title} class="aspect-video w-full max-w-2xl rounded-2xl object-cover shadow-xl" />
                <div class="flex-1">

                    <div class="mb-3 flex flex-wrap gap-2">
                        <div class="badge badge-primary rounded-full">{t.texts.featured}</div>
                        <div class="badge badge-outline rounded-full">{t.texts.client[softwareHero.client]}</div>
                        <div class="badge badge-outline rounded-full">{t.texts.status[softwareHero.status]}</div>
                        <div class="badge badge-outline rounded-full">{t.texts.privacy[softwareHero.privacy]}</div>
                    </div>

                    <h3 class="text-3xl sm:text-5xl font-bold">{t[softwareHero.key].title}</h3>
                    <div class="mt-3 text-sm opacity-60">
                        {softwareHero.startDate}
                        {softwareHero.endDate && ` \u2192 ${softwareHero.endDate}`}
                    </div>

                    <p class="mt-6 opacity-75">{t[softwareHero.key].summary}</p>

                    <div class="mt-6 flex flex-wrap gap-2">
                        {softwareHero.categories.map(category => ( <span class="badge badge-secondary rounded-full">{t.texts.categories[category]}</span> ))}
                    </div>

                    <div class="mt-6 flex flex-wrap gap-2">
                        {softwareHero.stack.map(tech => (
                            <span class="badge badge-neutral badge-sm gap-1 py-3.5 text-xs rounded-full align-middle">
                                <CommonIcon name={tech} size="md" />
                                {TECHNOLOGIES[tech].visual.name}
                            </span>
                        ))}
                    </div>

                    <div class="mt-8 flex flex-wrap gap-2">
                        {softwareHero.links?.website && (<a href={softwareHero.links.website} class="btn btn-primary">{t.texts.links.website}</a>)}
                        {softwareHero.links?.github && (<a href={softwareHero.links.github} class="btn btn-outline">{t.texts.links.github}</a>)}
                        {softwareHero.links?.video && (<a href={softwareHero.links.video} class="btn btn-outline">{t.texts.links.video}</a>)}
                    </div>
                </div>
            </div>
        </article>

        <!-- GRID -->
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {softwareProjects.map((project: ProjectType) => (
                <article data-aos="fade-up" class="card relative rounded-lg border border-base-300 bg-base-100 shadow-sm hover:shadow-lg transition-shadow">
                    <Image src={project.images.cover} alt={t[project.key].title} class="rounded-t-lg aspect-video w-full object-cover" />
                    <span class="absolute top-3 right-3 badge badge-success badge-sm rounded-full select-none bg-success/60 font-semibold">{t.texts.status[project.status]}</span>
                    <span class="absolute top-3 left-3 badge badge-info badge-sm rounded-full select-none bg-info/60 font-semibold">{t.texts.privacy[project.privacy]}</span>

                    <div class="card-body">
                        <h3 class="card-title">{t[project.key].title}</h3>

                        <div class="flex flex-wrap gap-2 my-1">
                            <span class="badge badge-outline badge-sm rounded-full">
                                {project.startDate}
                                {(project.endDate && project.startDate !== project.endDate) ? ` \u2192 ${project.endDate}` : ""}
                            </span>
                            <span class="badge badge-outline badge-sm rounded-full">{t.texts.client[project.client]}</span>
                        </div>

                        <div class="flex flex-wrap gap-1">
                            {project.categories.map(category => (
                                <span class="badge badge-ghost badge-sm">{t.texts.categories[category]}</span>
                            ))}
                        </div>

                        <div class="divider my-1" />

                        <div class="flex flex-wrap gap-2">
                            {project.stack.map(tech => (
                                <span class="badge badge-neutral badge-sm rounded-full align-middle gap-1">
                                    <CommonIcon name={tech} size="sm" />
                                    {TECHNOLOGIES[tech].visual.name}
                                </span>
                            ))}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </section>
</section>