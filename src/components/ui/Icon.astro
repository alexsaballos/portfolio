---
import { type IconData } from "../../config/assets.ts";

const { icon, size, classname: classname = "" } = Astro.props as {
    icon: IconData;
    size?: string;
    classname?: string;
};

const uuid = crypto.randomUUID();       // Accessibility
const sizeMap = { xs: 15, sm: 20, md: 35, lg: 45, xl: 60, dxl:70 } as const;
const pixelSize = sizeMap[(size ?? icon.size) as keyof typeof sizeMap];
---

<svg
    width={pixelSize}
    height={pixelSize}
    class={`shrink-0 ${classname}`}
    aria-labelledby={`icon-title-${uuid} icon-desc-${uuid}`}
    viewBox="0 0 640 640"
    fill="currentColor"
    overflow="visible"
    focusable="false"
    role="img"
>
    <title id={`icon-title-${uuid}`}>{icon.title}</title>
    <desc id={`icon-desc-${uuid}`}>{icon.desc}</desc>
    <use href={icon.href} />
</svg>