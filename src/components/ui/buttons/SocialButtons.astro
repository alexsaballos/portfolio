---
import type { BaseVanityEntryType, VanityEntryGroupType } from "../../../types/VanityType";
import Icon from "../../ui/libraries/Icon.astro";
import { pickVanityGroup } from "../../../config/vanity";

const { variant } = Astro.props as { variant: VanityEntryGroupType; };
const RequestedButtons: BaseVanityEntryType[] = Object.values(
    (variant === "social") ? pickVanityGroup("social") : pickVanityGroup("contact")
);
---

<div class="flex flex-row justify-center">
    {RequestedButtons.map(button => (
        <a class="p-0 m-0" href={button.frontend.link} aria-label={button.metadata.label} target="_blank" rel="noopener noreferrer">
            <Icon icon={button.frontend.icon} size="lg"
                classname="shadow-none transition-transform duration-500 ease-out hover:text-secondary hover:scale-120" />
        </a>
    ))}
</div>