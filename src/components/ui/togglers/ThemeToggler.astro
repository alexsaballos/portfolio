---
import CommonIcon from "@ui/CommonIcon.astro";
---

<label aria-label="Change the current Theme" class="btn btn-ghost shadow-none btn-square swap swap-rotate transition-transform duration-500 ease-out hover:text-secondary hover:scale-120">
    <input type="checkbox" class="theme-controller" value="dark" />
    <CommonIcon name="sun" classname="swap-off" />
    <CommonIcon name="moon" classname="swap-on" />
</label>
<script src="@scripts/widgets/theme-sync.ts"></script>