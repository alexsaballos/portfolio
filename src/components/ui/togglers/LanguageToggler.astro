---
import { LANGUAGES } from "@config/languages";
import { ROUTE } from "@config/routes/routing";

import type { AdmittedLanguagesType } from "@typing/LocalesType";
import type { DirectoryPageSlugsType } from "@src/types/routes/PagesType";

import CommonIcon from "@ui/CommonIcon.astro";

const classname = Astro.props.classname as string;

// Get the current URL's slug for appropriate LanguageToggling
const segments: string[] = Astro.url.pathname.split("/").filter(Boolean);
const pageSlug = ((segments.length > 1) ? (`${segments[1]}`) : "") as DirectoryPageSlugsType;
const routedPage = (lang: AdmittedLanguagesType): string =>
    ((pageSlug == "") ? ROUTE.home(lang) : ROUTE.page(lang, pageSlug));
---

<div class=`dropdown dropdown-center ${classname}`>
    <div tabindex="0" role="button" aria-label="Change the current Language"
        class="btn btn-ghost btn-square shadow-none transition-transform duration-500 ease-out hover:text-secondary hover:scale-120">
        <CommonIcon name="globe" />
    </div>
    <ul tabindex="-1" class="dropdown-content menu bg-base-200 text-base-content rounded-box gap-1 w-30 my-2 p-1">
        {Object.values(LANGUAGES).map((entry) => (
            <li><a href={routedPage(entry.code.lang)}>
                <CommonIcon name={entry.icon} />
                <p>{entry.name.localized}</p>
            </a></li>
        ))}
    </ul>
</div>