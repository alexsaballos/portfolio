---
import TestIcon from "@ui/TestIcon.astro";
import type { TechnologiesType } from "@typing/AssetsType";

const selection = Astro.props.selection as TechnologiesType;
const t = Astro.locals.t;
---

<div data-aos="zoom-in" class="tooltip tech select-none" style={`--tech-color: ${selection.visual.color}`}>
    <div class="select-none tooltip-content rounded-2xl flex flex-row ring-4 ring-base-300">
        <TestIcon name={selection.visual.icon} size="dxl" classname="flex-1 justify-center" />
        <div class="flex-2">
            <h1 class="font-bold text-lg text-left">{selection.visual.name}</h1>
            <p class="text-md text-left">{t.stack.technologies[selection.metadata.key]}</p>
        </div>
    </div>
    <div class="select-none badge badge-lg tech text-white transition-transform duration-500 ease-out hover:opacity-30"
        style={`--tech-color: ${selection.visual.color}`}>
        <TestIcon name={selection.visual.icon} classname="py-0.5" />
        <p>{selection.visual.name}</p>
    </div>
</div>