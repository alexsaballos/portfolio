---
import { PICTURES } from "@config/assets";
import { PERSONAL } from "@config/personal";
import Image from "astro/components/Image.astro";

const classname = Astro.props.classname as string;
---

<div class="avatar select-none">
    <div class=`ring-secondary ring-4 rounded-full hover:ring-6 ${classname}`>
        <figure>
            <Image src={PICTURES.PFP} alt=`${PERSONAL.name} - Profile Picture` />
        </figure>
    </div>
</div>