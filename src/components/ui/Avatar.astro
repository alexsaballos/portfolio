---
import { PERSONAL } from "@config/personal";
import { SYSTEM } from "@config/routes/links";

const classname = Astro.props.classname as string;
---

<div class="avatar select-none">
    <div class=`ring-secondary ring-4 rounded-full shadow-none ${classname}`>
        <figure>
            <img src={SYSTEM.notable.external.branding.pfp} loading="eager" alt=`${PERSONAL.name} - Profile Picture` />
        </figure>
    </div>
</div>