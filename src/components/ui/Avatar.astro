---
import { ASSETS } from "../../config/assets";
import Image from "astro/components/Image.astro";

const { classname } = Astro.props as {
    size: string;
    classname: string;
};
---

<div class="avatar">
    <div class=`ring-secondary ring-4 rounded-full hover:ring-primary hover:ring-6 ${classname}`>
        <figure>
            <Image src={ASSETS.pictures.PFP} alt="Alexander Saballos - Profile Picture" />
        </figure>
    </div>
</div>