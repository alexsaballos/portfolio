---
import { ASSETS } from "../../config/assets";
import { SOCIAL } from "../../config/personal";
import Icon from "./Icon.astro";

const SOCIAL_BUTTONS = {
    linkedin: {
        icon: ASSETS.icons.linkedin,
        link: SOCIAL.linkedin_URL,
        label: "My LinkedIn Profile"
    },
    github: {
        icon: ASSETS.icons.github,
        link: SOCIAL.github_URL,
        label: "My GitHub Profile"
    },
    handshake: {
        icon: ASSETS.icons.handshake,
        link: SOCIAL.handshake_URL,
        label: "My Handshake Profile"
    },
    merit: {
        icon: ASSETS.icons.merit,
        link: SOCIAL.merit_URL,
        label: "My Merit Page"
    },
    wisp: {
        icon: ASSETS.icons.wisp,
        link: SOCIAL.wisp_URL,
        label: "WISP Official Website"
    }
}
---

<div class="flex flex-row justify-center">
    {Object.values(SOCIAL_BUTTONS).map(button => (
        <a class="p-0 m-0" href={button.link} aria-label={button.label}>
            <Icon icon={button.icon} size="lg" />
        </a>
    ))}
</div>