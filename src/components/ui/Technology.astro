---
import type { TechnologiesType } from "../../types/AssetsType";
import Icon from "../ui/libraries/Icon.astro";

const { selection } = Astro.props as { selection: TechnologiesType };
---

<div class="tooltip tech" style={`--tech-color: ${selection.color}`}>
    <div class="tooltip-content rounded-2xl flex flex-row ring-4 ring-base-300">
        <Icon icon={selection.icon} size="dxl" classname="flex-1 justify-center" />
        <div class="flex-2">
            <h1 class="font-bold text-lg text-left">{selection.name}</h1>
            <p class="text-md text-left">{selection.kind} used in {selection.domains}</p>
        </div>
    </div>
    <div class="badge badge-lg tech text-white transition-transform duration-500 ease-out hover:opacity-30"
        style={`--tech-color: ${selection.color}`}>
        <Icon icon={selection.icon} classname="py-0.5" />
        {selection.name}
    </div>
</div>