---
import { ICONS } from "../../config/assets";
import { ROUTE } from "../../config/routing";

import type { NavigationPageType, CategoryPageType } from "../../types/PagesType";
import type { AdmittedLanguagesType, LocalesType } from "../../types/LocalesType";

import Icon from "../ui/libraries/Icon.astro";

const { locale, t } = Astro.locals as {
	locale: AdmittedLanguagesType;
	t: LocalesType;
};

const { page } = Astro.props as { page: (NavigationPageType | CategoryPageType); };

const homeLink: string = ROUTE.home(locale);
const pageLink: string = ROUTE.page(locale, page.slug);
---

<div class="breadcrumbs text-md my-5 ml-5 sm:ml-10">
	<ul>
		<li><a href={homeLink} class="hover:text-secondary hover:font-bold">
			<Icon icon={ICONS.home} size="xs" />
			<p>{t.breadcrumbs.home}</p>
		</a></li>
		<li><a href={pageLink}  class="hover:text-secondary hover:font-bold">
			<Icon icon={page.icon} size="xs" />
			<p>{t.breadcrumbs[page.key]}</p>
		</a></li>
	</ul>
</div>