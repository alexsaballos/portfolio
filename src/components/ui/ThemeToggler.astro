---
import { ASSETS } from "../../config/assets";
import Icon from "../ui/Icon.astro";
---

<label class="btn btn-ghost shadow-none btn-square swap swap-rotate">
    <input type="checkbox" class="theme-controller" value="dark" />
    <Icon icon={ASSETS.icons.sun} classname="swap-off" />
    <Icon icon={ASSETS.icons.moon} classname="swap-on" />
</label>