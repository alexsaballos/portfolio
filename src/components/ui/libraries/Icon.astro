---
import type { IconsType } from "../../../types/AssetsType";

const { icon, size, classname: classname = "" } = Astro.props as {
    icon: IconsType;
    size?: string;
    classname?: string;
};

const uuid = crypto.randomUUID();       // Accessibility
const sizeMap = { dxs: 6, xs: 15, sm: 20, md: 35, lg: 45, xl: 60, dxl:70, exl: 150, ixl:280 } as const;
const pixelSize: (6 | 15 | 20 | 35 | 45 | 60 | 70 | 150 | 280) = sizeMap[(size ?? icon.size) as keyof typeof sizeMap];
---

<svg
    width={pixelSize}
    height={pixelSize}
    class={`shrink-0 ${classname}`}
    aria-labelledby={`icon-title-${uuid} icon-desc-${uuid}`}
    viewBox="0 0 640 640"
    fill="currentColor"
    overflow="visible"
    focusable="false"
    role="img"
>
    <title id={`icon-title-${uuid}`}>{icon.title}</title>
    <desc id={`icon-desc-${uuid}`}>{icon.desc}</desc>
    <use href={icon.href} />
</svg>