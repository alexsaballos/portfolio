---
import { ASSETS } from "../../config/assets";
import Icon from "../ui/Icon.astro";
---

<div class="shrink-0 bg-primary border-6 border-solid border-secondary rounded-full relative flex items-center justify-center p-6
            shadow-none duration-300">
    <label class="swap swap-rotate w-full h-full flex items-center justify-center" aria-label="Toggle Dark Mode">
        <input id="theme-toggler" type="checkbox" class="theme-controller shadow-none sr-only" value="dark" aria-label="Dark Mode Toggler" />

        <div class="swap-off absolute inset-0 flex items-center justify-center shadow-none">
            <Icon icon={ASSETS.icons.sun} class="text-secondary fill-current" size="lg" />
        </div>
        <div class="swap-on absolute inset-0 flex items-center justify-center shadow-none">
            <Icon icon={ASSETS.icons.moon} class="text-secondary fill-current" size="lg" />
        </div>
    </label>
</div>