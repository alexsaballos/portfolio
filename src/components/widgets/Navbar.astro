---
import { PERSONAL } from "../../config/personal";
import type { Translations } from "../../types/locales";
import LanguageToggler from "../ui/LanguageToggler.astro";
import ThemeToggler from "../ui/ThemeToggler.astro";

const { t } = Astro.locals as {
    t: Translations
};
---

<div class="navbar bg-transparent">
    <div class="flex-1">
        <a class="btn btn-ghost text-xl" href={PERSONAL.url} aria-label={PERSONAL.description}>
            {PERSONAL.short_name}
        </a>
    </div>
    <div class="flex-none align-middle">
        <ul class="menu menu-horizontal px-1">
            <li><a>{t.navbar.projects}</a></li>
            <li><a>{t.navbar.experience}</a></li>
            <li><a>{t.navbar.certifications}</a></li>
            <li><a>{t.navbar.honors}</a></li>
            <li><a>{t.navbar.contact}</a></li>
            <li><LanguageToggler /></li>
            <li><ThemeToggler /></li>
        </ul>
    </div>
</div>