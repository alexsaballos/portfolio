---
import { ICONS } from "../../config/assets";
import { ROUTE } from "../../config/routing";
import { NAVIGATION_PAGES } from "../../config/pages";
import type { AdmittedLanguagesType, LocalesType } from "../../types/LocalesType";

import Icon from "../ui/libraries/Icon.astro";
import IconHome from "../ui/buttons/IconHome.astro";
import LanguageToggler from "../ui/togglers/LanguageToggler.astro";
import ThemeToggler from "../ui/togglers/ThemeToggler.astro";

const { t, locale } = Astro.locals as { t: LocalesType, locale: AdmittedLanguagesType }
const { background } = Astro.props as { background: string; }
---

<div class="drawer z-999 pt-5">
    <input id="intro-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col">
        <div class={`navbar bg-${background} w-full`}>
            <div class="flex-none md:hidden">
                <label for="intro-drawer" aria-label="Open Sidebar" class="btn btn-square btn-ghost ml-5">
                    <Icon icon={ICONS.hamburger_open} />
                </label>
            </div>
            <div class="navbar-start ml-5 hidden md:flex">
                <IconHome />
            </div>
            <div class="navbar-center hidden md:flex">
                <ul class="menu menu-horizontal">
                    {Object.values(NAVIGATION_PAGES).map(entry => (
                        <li><a href={ROUTE.page(locale, entry.slug)} class="hover:font-bold border-secondary hover:border-b-4 hover:-my-1">
                            {t.navbar[entry.key]}
                        </a></li>
                    ))}
                </ul>
            </div>
            <div class="navbar-end hidden mr-5 md:flex">
                <LanguageToggler />
                <div class="divider divider-horizontal"></div>
                <ThemeToggler />
            </div>
        </div>
    </div>
    <div class="drawer-side text-white">
        <label for="intro-drawer" aria-label="Close Sidebar" class="drawer-overlay"></label>
        <ul class="menu bg-primary min-h-full w-65 text-lg p-6 pt-10 gap-10 flex flex-col">
            {Object.values(NAVIGATION_PAGES).map(entry => (
                <li><a href={ROUTE.page(locale, entry.slug)} class="hover:font-bold">
                    {t.navbar[entry.key]}
                </a></li>
            ))}
            <div class="flex flex-row justify-center mt-auto py-1">
                <IconHome />
                <div class="divider divider-horizontal"></div>
                <LanguageToggler classname="dropdown-top" />
                <div class="divider divider-horizontal"></div>
                <ThemeToggler />
            </div>
        </ul>
    </div>
</div>