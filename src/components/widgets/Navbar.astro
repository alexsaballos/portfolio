---
import { ASSETS } from "../../config/assets";
import type { Translations } from "../../types/locales";

import Icon from "../ui/Icon.astro";
import LanguageToggler from "../ui/LanguageToggler.astro";
import ThemeToggler from "../ui/ThemeToggler.astro";

const { t } = Astro.locals as { t: Translations };

const links = {
    projects: t.navbar.projects,
    experience: t.navbar.experience,
    leadership: t.navbar.leadership,
    certifications: t.navbar.certifications,
    honors: t.navbar.honors,
    contact: t.navbar.contact
}
---

<div class="drawer ml-4 z-999">
    <input id="intro-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col">
        <div class="navbar bg-transparent w-full">
            <div class="flex-none md:hidden">
                <label for="intro-drawer" aria-label="Open Sidebar" class="btn btn-square btn-ghost">
                    <Icon icon={ASSETS.icons.hamburger_menu} />
                </label>
            </div>
            <div class="hidden md:block">
                <ul class="menu menu-horizontal px-1">
                    {Object.values(links).map(link => (<li><a href="#" class="hover:font-bold">{link}</a></li>))}
                    <div class="flex flex-row gap-1">
                        <div class="divider divider-horizontal"></div>
                        <LanguageToggler />
                        <ThemeToggler />
                    </div>
                </ul>
            </div>
        </div>
    </div>
    <div class="drawer-side text-white">
        <label for="intro-drawer" aria-label="Close Sidebar" class="drawer-overlay"></label>
        <ul class="menu bg-primary min-h-full w-60 text-lg p-6 pt-10 gap-10 flex flex-col">
            {Object.values(links).map(link => (<li><a href="#" class="hover:font-bold">{link}</a></li>))}
            <div class="flex flex-row justify-center mt-auto px-2 py-1">
                <LanguageToggler classname="dropdown-top" />
                <div class="divider divider-horizontal"></div>
                <ThemeToggler />
            </div>
        </ul>
    </div>
</div>