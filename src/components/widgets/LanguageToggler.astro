---
import { ASSETS } from "../../config/assets";
import Icon from "../ui/Icon.astro";

const languages = {
    de: {link: "/testing/de/", flag: ASSETS.flags.de, alt: "de-de", name: "Deutsche"},
    en: {link: "/testing/en/", flag: ASSETS.flags.en, alt: "en-us", name: "English"},
    es: {link: "/testing/es/", flag: ASSETS.flags.es, alt: "es-mx", name: "Español"}
};

const {locale} = Astro.props as {locale: string};
const TabName: string =
    (locale === "de") ? "SPRACHE" :
    (locale === "es") ? "IDIOMA" :
    "LANGUAGE";
---

<div class="dropdown dropdown-left dropdown-center">
    <div tabindex="0" role="button"
    class="btn m-1 -rotate-90 bg-primary rounded-b-none rounded-t-lg text-white w-30">
        <Icon icon={ASSETS.icons.translate} class="text-white" />
        <span>{TabName}</span>
    </div>
    <ul tabindex="-1" class="dropdown-content menu bg-base-200 rounded-box gap-1 -mr-7 w-30 p-1">
        {Object.values(languages).map((entry) => (
        <li>
            <a href={entry.link}><img src={entry.flag} alt={entry.alt} loading="eager" class="h-5 w-5" />
                {entry.name}
            </a>
        </li>
        ))}
    </ul>
</div>