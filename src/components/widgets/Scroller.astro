---
import CommonIcon from "@ui/CommonIcon.astro";

const ScrollButtons = {
    top: {
        id: "scrollTop",
        aria_label: "Scroll to Top",
        icon: "chevron_up"
    },
    bottom: {
        id: "scrollBottom",
        aria_label: "Scroll to Bottom",
        icon: "chevron_down"
    }
} as const;
---

<div id="scrollControls"
    class="fixed bottom-5 right-5 z-998 flex flex-col gap-3 opacity-0 pointer-events-none transition-opacity duration-500 ease-out">
        {Object.values(ScrollButtons).map(button =>
            <button id={button.id} aria-label={button.aria_label}
                class="shadow-none border-none btn btn-square bg-secondary rounded-lg hover:scale-110 transition-transform duration-300 ring-4 ring-base-200">
                    <CommonIcon name={button.icon} classname="text-white" />
            </button>
        )}
</div>
<script src="@scripts/widgets/scroller.ts"></script>