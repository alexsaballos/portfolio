---
import CommonIcon from "@ui/CommonIcon.astro";

const ScrollButtons = {
    top: {
        id: "scrollTop",
        aria_label: "Scroll to Top",
        icon: "chevron_up"
    },
    bottom: {
        id: "scrollBottom",
        aria_label: "Scroll to Bottom",
        icon: "chevron_down"
    }
} as const;
---

<div id="scrollControls"
    class="fixed bottom-5 right-5 z-998 flex flex-col gap-3 pointer-events-none opacity-0 transition-opacity duration-500 ease-out">
        {Object.values(ScrollButtons).map(button =>
            <button id={button.id} aria-label={button.aria_label}
                class="btn btn-square rounded-lg shadow-2xl bg-base-200/60 border border-base-content/10 backdrop-blur-sm hover:scale-110 transition-transform duration-300">
                    <CommonIcon name={button.icon} classname="text-base-content" />
            </button>
        )}
</div>
<script src="@scripts/widgets/scroller.ts"></script>