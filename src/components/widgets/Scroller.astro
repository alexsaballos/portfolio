---
import { ASSETS } from "../../config/assets";
import Icon from "../ui/Icon.astro";
---

<div class="flex flex-col gap-2 shrink-0 shadow-none">
    <button id="scrollTop" class="p-0 m-0 w-12 h-12 border-secondary border-solid border-6 shadow-none btn btn-circle bg-secondary" aria-label="Scroll to Top">
        <Icon icon={ASSETS.icons.chevron_up} class="text-primary" size="lg" />
    </button>
    <button id="scrollBottom" class="p-0 m-0 w-12 h-12 border-secondary border-solid border-6 shadow-none btn btn-circle bg-secondary" aria-label="Scroll to Bottom">
        <Icon icon={ASSETS.icons.chevron_down} class="text-primary" size="lg" />
    </button>
</div>