---
const { pdf, id = "pdf-viewer" } = Astro.props as {
    pdf: string;
    id?: string;
};
---

<div id={id} data-pdf={pdf}
    class="w-full h-100 sm:h-120 md:h-140 flex flex-col flex-nowrap scrollbar-thin scrollbar-thumb-secondary overflow-x-hidden overflow-y-auto items-center gap-2 px-4"></div>
<script src="@scripts/pdf-viewer.ts"></script>